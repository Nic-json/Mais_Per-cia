@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Processo " + Model.Numero; string StatusLaudoNome(StatusLaudo status) => status switch { StatusLaudo.EmElaboracao => "em elaboração", StatusLaudo.Concluido => "Concluído", _ => status.ToString() }; }
<header class="page-heading"><div><a asp-action="Processos" class="back-link">Voltar à lista</a><partial name="_PageTitle" model='new PageHeadingViewModel("PROCESSO / PERÍCIA", $"Perícia nº {Model.Numero}", Model.Status.ToString())' /></div><div class="heading-actions"><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar cadastro</a></div></header>
@if (TempData["MensagemFinanceira"] is string msg) { <partial name="_FeedbackMessage" model='new FeedbackMessageViewModel(msg, FeedbackMessageType.Success)' /> } @if (TempData["ErroFinanceiro"] is string erro) { <partial name="_FeedbackMessage" model='new FeedbackMessageViewModel(erro, FeedbackMessageType.Error)' /> }
<section id="resumo" class="form-panel process-summary-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Resumo do processo")' /><div class="process-summary-grid">
    <div class="process-summary-item"><b>Número da perícia</b><span>@Model.Numero</span></div>
    <div class="process-summary-item"><b>Comarca / Vara</b><span>@Model.Comarca / @Model.Vara</span></div>
    <div class="process-summary-item"><b>Tipo de perícia</b><span>@(string.IsNullOrWhiteSpace(Model.TipoPericia) ? "—" : Model.TipoPericia)</span></div>
    <div class="process-summary-item"><b>Enviada / aceita</b><span>@(Model.DataEnvio?.ToString("dd/MM/yyyy") ?? "—") / @(Model.DataAceite?.ToString("dd/MM/yyyy") ?? "—")</span></div>
    <div class="process-summary-item"><b>Prazo geral</b><span>@(Model.PrazoLaudo?.ToString("dd/MM/yyyy") ?? "—")</span></div>
    <div class="process-summary-item process-summary-observations"><b>Observações</b><span>@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "—" : Model.Observacoes)</span></div>
</div></section>
<section id="periciados" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Periciados")' />@if (Model.Periciados.Any()) { <div class="table-responsive"><table class="table process-periciados-table"><thead><tr><th>Nome</th><th>Telefone</th><th>Observações</th></tr></thead><tbody>@foreach (var pessoa in Model.Periciados.OrderBy(p => p.Nome)) { <tr><td>@pessoa.Nome</td><td>@(string.IsNullOrWhiteSpace(pessoa.Contato) ? "—" : pessoa.Contato)</td><td>@(string.IsNullOrWhiteSpace(pessoa.RegistroEntrevista) ? "—" : pessoa.RegistroEntrevista)</td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum periciado cadastrado nesta perícia.</p> }</section>
<section id="laudos" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Laudos")' />@if (Model.Laudos.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Periciado</th><th>Status</th><th>Prazo</th></tr></thead><tbody>@foreach (var laudo in Model.Laudos.OrderBy(l => l.Id)) { <tr><td>@laudo.NumeroLaudo</td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td>@StatusLaudoNome(laudo.Status)</td><td>@(laudo.Prazo?.ToString("dd/MM/yyyy") ?? "Sem prazo")</td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum laudo cadastrado.</p> }</section>
<section id="agenda" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Agenda e prazos")' /><div class="process-agenda-list">
    @foreach (var evento in Model.EventosAgenda.Where(e => !e.Cancelado).OrderBy(e => e.Inicio))
    {
        <article class="process-agenda-item"><span class="process-agenda-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M3.5 10h17"/></svg></span><div class="process-agenda-copy"><strong>@evento.Titulo</strong><span>@evento.Inicio.ToString("dd/MM/yyyy 'às' HH:mm")@(string.IsNullOrWhiteSpace(evento.Local) ? "" : $" · {evento.Local}")</span></div></article>
    }
    @if (Model.PrazoLaudo.HasValue)
    {
        <article class="process-agenda-item process-agenda-deadline"><span class="process-agenda-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M3.5 10h17"/><path d="M8 14h3M8 17h6"/></svg></span><div class="process-agenda-copy"><span class="process-agenda-label">Prazo geral do laudo</span><time datetime="@Model.PrazoLaudo.Value.ToString("yyyy-MM-dd")">@Model.PrazoLaudo.Value.ToString("dd/MM/yyyy")</time></div></article>
    }
</div></section>
<section id="honorarios" class="form-panel process-finance-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Honorários")' /><div class="process-finance-summary"><div><span>Valor fixado</span><strong>@Model.ValorHonorarios.ToString("C")</strong></div><div><span>Total recebido</span><strong>@Model.ValorRecebido.ToString("C")</strong></div><div><span>Saldo a receber</span><strong>@(((decimal)ViewBag.Saldo).ToString("C"))</strong></div></div><div class="process-finance-actions"><button type="button" class="btn btn-outline-secondary" data-app-modal-open="#process-sei-modal" data-app-modal-template="#process-sei-template">Registrar data do SEI</button><button type="button" class="btn btn-primary" data-app-modal-open="#process-payment-modal" data-app-modal-template="#process-payment-template">Registrar pagamento</button></div><div class="process-payment-history"><h3>Pagamentos registrados</h3>@if (Model.Pagamentos.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Valor</th><th>Observação</th><th>Ação</th></tr></thead><tbody>@foreach (var pag in Model.Pagamentos.OrderByDescending(p => p.DataRecebimento)) { <tr><td>@(pag.DataRecebimento?.ToString("dd/MM/yyyy") ?? "Saldo anterior (data não registrada)")</td><td>@pag.Valor.ToString("C")</td><td>@(string.IsNullOrWhiteSpace(pag.Observacoes) ? "—" : pag.Observacoes)</td><td><form asp-action="ExcluirPagamento" method="post"><input type="hidden" name="id" value="@pag.Id"/><button class="btn btn-sm btn-outline-danger" data-confirm-message="Remover este pagamento?">Remover</button></form></td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum pagamento registrado.</p> }</div></section>
<partial name="_AppModal" model='new AppModalViewModel("process-sei-modal", "Registrar data do SEI", "Informe ou atualize a data de envio pelo SEI.")' />
<template id="process-sei-template"><form asp-action="AtualizarDataSei" method="post" class="app-modal-form"><input type="hidden" name="id" value="@Model.Id"/><label>Data do SEI<input type="date" name="dataSei" value="@(Model.DataEnvio?.ToString("yyyy-MM-dd"))" class="form-control"/></label><div class="app-modal-actions"><button type="button" class="btn btn-outline-secondary" data-app-modal-close>Cancelar</button><button type="submit" class="btn btn-primary">Salvar data</button></div></form></template>
<partial name="_AppModal" model='new AppModalViewModel("process-payment-modal", "Registrar pagamento", "Informe o valor e a data do recebimento.")' />
<template id="process-payment-template"><form asp-action="RegistrarPagamento" method="post" class="app-modal-form"><input type="hidden" name="id" value="@Model.Id"/><label>Valor recebido<input id="valorPagamento" type="hidden" name="valor" data-currency-value/><span class="input-group"><span class="input-group-text">R$</span><input id="valorPagamentoMascara" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" class="form-control" data-currency-mask data-currency-target="valorPagamento" required/></span></label><label>Data do recebimento<input type="date" name="dataRecebimento" value="@BrasiliaTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></label><label>Observação (opcional)<input name="observacoes" class="form-control" maxlength="2000"/></label><div class="app-modal-actions"><button type="button" class="btn btn-outline-secondary" data-app-modal-close>Cancelar</button><button type="submit" class="btn btn-primary">Registrar pagamento</button></div></form></template>

<section id="historico" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Histórico")' />@if (Model.Historico.Any()) { <ul class="list-group process-history-list">@foreach (var item in Model.Historico.OrderByDescending(x => x.CriadoEm).Take(100)) { <li class="list-group-item"><div class="process-history-copy"><strong>@item.Tipo</strong><span>@item.Descricao</span></div><div class="process-history-meta"><time datetime="@item.CriadoEm.ToUniversalTime().ToString("O")">@BrasiliaTime.ToBrasilia(item.CriadoEm).ToString("dd/MM/yyyy 'às' HH:mm")</time><span>@(item.Responsavel ?? "Sistema")</span></div></li> }</ul> } else { <p class="muted mb-0">Nenhum registro no histórico.</p> }</section>


