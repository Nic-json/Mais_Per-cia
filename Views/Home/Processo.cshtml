@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Processo " + Model.Numero; var documentos = Model.Documentos.OrderByDescending(d => d.EnviadoEm).ToList(); }
<div class="page-heading"><div><a asp-action="Processos" class="back-link">← Voltar à lista</a><div class="eyebrow">PROCESSO / PERÍCIA</div><h1>@(Model.NumeroProcesso ?? "Processo sem CNJ")</h1><p>Perícia nº @Model.Numero · @Html.DisplayFor(m => m.Status)</p></div><div class="heading-actions"><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar cadastro</a></div></div>
@if (TempData["MensagemFinanceira"] is string msg) { <div class="alert alert-success">@msg</div> } @if (TempData["ErroFinanceiro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<nav class="nav nav-pills mb-3 flex-wrap"><a class="nav-link" href="#resumo">Resumo</a><a class="nav-link" href="#periciados">Periciados</a><a class="nav-link" href="#laudos">Laudos</a><a class="nav-link" href="#agenda">Agenda</a><a class="nav-link" href="#honorarios">Honorários</a><a class="nav-link" href="#documentos">Documentos / histórico</a></nav>
<section id="resumo" class="form-panel mb-3"><h2>Resumo do processo</h2><div class="row g-3"><div class="col-md-4"><b>Número CNJ</b><div>@(Model.NumeroProcesso ?? "—")</div></div><div class="col-md-4"><b>Perícia</b><div>@Model.Numero</div></div><div class="col-md-4"><b>Comarca / Vara</b><div>@Model.Comarca / @Model.Vara</div></div><div class="col-md-4"><b>Magistrado(a)</b><div>@(Model.Magistrado ?? "—")</div></div><div class="col-md-4"><b>Tipo de perícia</b><div>@(Model.TipoPericia ?? "—")</div></div><div class="col-md-4"><b>Enviada / aceita</b><div>@Model.DataEnvio?.ToString("dd/MM/yyyy") / @Model.DataAceite?.ToString("dd/MM/yyyy")</div></div><div class="col-md-4"><b>Prazo geral</b><div>@Model.PrazoLaudo?.ToString("dd/MM/yyyy")</div></div><div class="col-12"><b>Observações</b><div>@(Model.Observacoes ?? "—")</div></div></div></section>
<section id="periciados" class="form-panel mb-3"><h2>Periciados</h2>@if (TempData["ErroPericiado"] is string erroPessoa) { <div class="alert alert-danger">@erroPessoa</div>}
<form asp-action="AdicionarPericiado" method="post" class="row g-2 align-items-end mb-4"><input type="hidden" name="id" value="@Model.Id"/><div class="col-md-4"><label class="form-label">Nome</label><input name="nome" class="form-control" maxlength="160" required/></div><div class="col-md-2"><label class="form-label">Papel</label><input name="papel" class="form-control" maxlength="80" placeholder="Autor, réu..."/></div><div class="col-md-3"><label class="form-label">Relação</label><input name="relacao" class="form-control" maxlength="120"/></div><div class="col-md-2"><label class="form-label">Contato</label><input name="contato" class="form-control" maxlength="200"/></div><div class="col-md-1"><button class="btn btn-primary">Adicionar</button></div></form>
@foreach (var pessoa in Model.Periciados) { <div class="border rounded p-3 mb-3"><form asp-action="AtualizarPericiado" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="periciadoId" value="@pessoa.Id"/><div class="row g-2"><div class="col-md-4"><label class="form-label">Nome</label><input name="nome" value="@pessoa.Nome" class="form-control" maxlength="160" required/></div><div class="col-md-2"><label class="form-label">Papel</label><input name="papel" value="@pessoa.Papel" class="form-control" maxlength="80"/></div><div class="col-md-3"><label class="form-label">Relação</label><input name="relacao" value="@pessoa.Relacao" class="form-control" maxlength="120"/></div><div class="col-md-3"><label class="form-label">Contato</label><input name="contato" value="@pessoa.Contato" class="form-control" maxlength="200"/></div><div class="col-12"><label class="form-label">Registro de entrevista</label><textarea name="registroEntrevista" class="form-control" rows="2" maxlength="4000">@pessoa.RegistroEntrevista</textarea></div><div class="col-12"><button class="btn btn-outline-secondary">Salvar pessoa</button></div></div></form><form asp-action="ExcluirPericiado" method="post" class="mt-2"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="periciadoId" value="@pessoa.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir este periciado? Laudos vinculados ficarão sem associação.')">Excluir pessoa</button></form></div> }</section>
<section id="laudos" class="form-panel mb-3"><div class="d-flex justify-content-between"><h2>Laudos</h2><a asp-action="Laudos">Central de laudos</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Periciado</th><th>Status</th><th>Prazo</th><th></th></tr></thead><tbody>@foreach (var laudo in Model.Laudos.OrderBy(l => l.NumeroLaudo)) { <tr><td>@laudo.NumeroLaudo</td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td><form asp-action="AtualizarStatusLaudo" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="laudoId" value="@laudo.Id"/><select name="status" class="form-select form-select-sm">@foreach (var s in Enum.GetValues<StatusLaudo>()) { <option value="@s" selected="@(s == laudo.Status)">@s</option> }</select><button class="btn btn-sm btn-outline-secondary">Salvar</button></form></td><td>@laudo.Prazo?.ToString("dd/MM/yyyy")</td><td><a asp-action="EditorLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id">Abrir editor</a></td></tr> }</tbody></table></div><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Criar/gerenciar laudos</a></section>
<section id="agenda" class="form-panel mb-3"><div class="d-flex justify-content-between"><h2>Agenda e prazos</h2><a asp-action="Agenda">Abrir agenda</a></div><ul>@foreach (var evento in Model.EventosAgenda.Where(e => !e.Cancelado).OrderBy(e => e.Inicio)) { <li>@evento.Inicio.ToString("dd/MM/yyyy HH:mm") · @evento.Titulo · @evento.Local</li> } @if (Model.PrazoLaudo.HasValue) { <li>Prazo geral do laudo: @Model.PrazoLaudo.Value.ToString("dd/MM/yyyy")</li> }</ul></section>
<section id="honorarios" class="form-panel mb-3"><h2>Honorários</h2><p>Fixados: <b>@Model.ValorHonorarios.ToString("C")</b> · Recebidos: <b>@Model.ValorRecebido.ToString("C")</b> · Saldo: <b>@(((decimal)ViewBag.Saldo).ToString("C"))</b></p><form asp-action="RegistrarPagamento" method="post" class="row g-2 align-items-end"><input type="hidden" name="id" value="@Model.Id"/><div class="col-md-2"><label class="form-label">Valor</label><input type="number" min="0.01" max="@ViewBag.Saldo" step="0.01" name="valor" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Data recebida</label><input type="date" name="dataRecebimento" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-4"><label class="form-label">Comprovante já anexado</label><select name="documentoPericiaId" class="form-select"><option value="">Sem comprovante</option>@foreach (var doc in documentos) { <option value="@doc.Id">@doc.NomeOriginal</option> }</select></div><div class="col-md-3"><label class="form-label">Observação</label><input name="observacoes" class="form-control" maxlength="2000"/></div><div class="col-md-1"><button class="btn btn-primary">Registrar</button></div></form><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Data</th><th>Valor</th><th>Observação</th><th>Comprovante</th><th></th></tr></thead><tbody>@foreach (var pag in Model.Pagamentos.OrderByDescending(p => p.DataRecebimento)) { <tr><td>@(pag.DataRecebimento?.ToString("dd/MM/yyyy") ?? "Saldo anterior (data não registrada)")</td><td>@pag.Valor.ToString("C")</td><td>@pag.Observacoes</td><td>@if (pag.DocumentoPericiaId.HasValue) { <a asp-action="BaixarDocumento" asp-route-id="@pag.DocumentoPericiaId">Baixar</a> }</td><td><form asp-action="ExcluirPagamento" method="post"><input type="hidden" name="id" value="@pag.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Remover este pagamento?')">Remover</button></form></td></tr> }</tbody></table></div></section>
<section id="documentos" class="form-panel mb-3"><h2>Documentos e histórico</h2><h3 class="h6 mt-3">Documentos</h3><ul>@foreach (var doc in documentos) { <li><a asp-action="BaixarDocumento" asp-route-id="@doc.Id">@doc.NomeOriginal</a> · @doc.EnviadoEm.ToLocalTime().ToString("dd/MM/yyyy")</li> }</ul><a asp-action="Editar" asp-route-id="@Model.Id">Adicionar ou gerenciar documentos</a><h3 class="h6 mt-4">Atividade recente</h3><ol class="list-group list-group-numbered">@foreach (var item in Model.Historico.OrderByDescending(x => x.CriadoEm).Take(100)) { <li class="list-group-item"><strong>@item.Tipo</strong> · @item.Descricao <span class="text-muted">@item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(item.Responsavel ?? "Sistema")</span></li> }</ol></section>
<section class="form-panel mb-3"><h2>Acompanhamento financeiro manual</h2><p>Registre tentativas de contato ou próximos passos. O sistema não envia cobranças automáticas.</p><form asp-action="RegistrarContatoFinanceiro" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@Model.Id"/><textarea name="descricao" class="form-control" rows="2" maxlength="900" required placeholder="Data, canal e resultado do contato"></textarea><button class="btn btn-outline-secondary">Registrar</button></form></section>
<section class="form-panel mb-3"><h2>Etapas dos honorários</h2><div class="row g-3"><div class="col-md-3"><strong>Fixados</strong><div>@Model.ValorHonorarios.ToString("C") · @Model.DataHonorariosFixados?.ToString("dd/MM/yyyy")</div></div><div class="col-md-3"><strong>Solicitados</strong><div>@Model.ValorHonorariosSolicitados.ToString("C") · @Model.DataHonorariosSolicitados?.ToString("dd/MM/yyyy")</div></div><div class="col-md-3"><strong>Liberados</strong><div>@Model.ValorHonorariosLiberados.ToString("C") · @Model.DataHonorariosLiberados?.ToString("dd/MM/yyyy")</div></div><div class="col-md-3"><strong>Recebidos</strong><div>@Model.ValorRecebido.ToString("C")</div></div><div class="col-12"><a asp-action="Editar" asp-route-id="@Model.Id" class="action-link">Atualizar valores e etapas</a></div></div></section>
