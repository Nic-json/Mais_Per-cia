@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Processo " + Model.Numero; }
<header class="page-heading"><div><a asp-action="Processos" class="back-link">Voltar à lista</a><partial name="_PageTitle" model='new PageHeadingViewModel("PROCESSO / PERÍCIA", $"Perícia nº {Model.Numero}", Model.Status.ToString())' /></div><div class="heading-actions"><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar cadastro</a></div></header>
@if (TempData["MensagemFinanceira"] is string msg) { <div class="alert alert-success">@msg</div> } @if (TempData["ErroFinanceiro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<section id="resumo" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Resumo do processo")' /><div class="row g-3"><div class="col-md-4"><b>Número da perícia</b><div>@Model.Numero</div></div><div class="col-md-4"><b>Comarca / Vara</b><div>@Model.Comarca / @Model.Vara</div></div><div class="col-md-4"><b>Tipo de perícia</b><div>@(Model.TipoPericia ?? "—")</div></div><div class="col-md-4"><b>Enviada / aceita</b><div>@Model.DataEnvio?.ToString("dd/MM/yyyy") / @Model.DataAceite?.ToString("dd/MM/yyyy")</div></div><div class="col-md-4"><b>Prazo geral</b><div>@Model.PrazoLaudo?.ToString("dd/MM/yyyy")</div></div><div class="col-12"><b>Observações</b><div>@(Model.Observacoes ?? "—")</div></div></div></section>
<section id="periciados" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Periciados")' />@if (Model.Periciados.Any()) { <div class="table-responsive"><table class="table process-periciados-table"><thead><tr><th>Nome</th><th>Telefone</th><th>Observações</th></tr></thead><tbody>@foreach (var pessoa in Model.Periciados.OrderBy(p => p.Nome)) { <tr><td>@pessoa.Nome</td><td>@(string.IsNullOrWhiteSpace(pessoa.Contato) ? "—" : pessoa.Contato)</td><td>@(string.IsNullOrWhiteSpace(pessoa.RegistroEntrevista) ? "—" : pessoa.RegistroEntrevista)</td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum periciado cadastrado nesta perícia.</p> }</section>
<section id="laudos" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Laudos")' />@if (Model.Laudos.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Periciado</th><th>Status</th><th>Prazo</th></tr></thead><tbody>@foreach (var laudo in Model.Laudos.OrderBy(l => l.Id)) { <tr><td>@laudo.NumeroLaudo</td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td>@laudo.Status</td><td>@(laudo.Prazo?.ToString("dd/MM/yyyy") ?? "Sem prazo")</td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum laudo cadastrado.</p> }</section>
<section id="agenda" class="form-panel mb-3"><div class="d-flex justify-content-between"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Agenda e prazos")' /><a asp-action="Agenda" class="action-link">Abrir agenda</a></div><ul>@foreach (var evento in Model.EventosAgenda.Where(e => !e.Cancelado).OrderBy(e => e.Inicio)) { <li>@evento.Inicio.ToString("dd/MM/yyyy HH:mm") · @evento.Titulo · @evento.Local</li> } @if (Model.PrazoLaudo.HasValue) { <li>Prazo geral do laudo: @Model.PrazoLaudo.Value.ToString("dd/MM/yyyy")</li> }</ul></section>
<section id="honorarios" class="form-panel process-finance-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Honorários")' /><div class="process-finance-summary"><div><span>Valor fixado</span><strong>@Model.ValorHonorarios.ToString("C")</strong></div><div><span>Total recebido</span><strong>@Model.ValorRecebido.ToString("C")</strong></div><div><span>Saldo a receber</span><strong>@(((decimal)ViewBag.Saldo).ToString("C"))</strong></div></div><div class="process-payment-entry process-sei-entry"><div class="process-payment-heading"><h3>Registro do SEI</h3><p>Informe ou atualize a data de envio pelo SEI.</p></div><form asp-action="AtualizarDataSei" method="post" class="process-sei-form"><input type="hidden" name="id" value="@Model.Id"/><label>Data do SEI<input type="date" name="dataSei" value="@(Model.DataEnvio?.ToString("yyyy-MM-dd"))" class="form-control"/></label><button class="btn btn-outline-secondary">Salvar data</button></form></div><div class="process-payment-entry"><div class="process-payment-heading"><h3>Registrar recebimento</h3><p>Informe os dados do pagamento recebido.</p></div><form asp-action="RegistrarPagamento" method="post" class="process-payment-form"><input type="hidden" name="id" value="@Model.Id"/><label>Valor recebido<input type="number" min="0.01" max="@ViewBag.Saldo" step="0.01" name="valor" class="form-control" required/></label><label>Data do recebimento<input type="date" name="dataRecebimento" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></label><label class="process-payment-note">Observação (opcional)<input name="observacoes" class="form-control" maxlength="2000"/></label><button class="btn btn-primary">Registrar pagamento</button></form></div><div class="process-payment-history"><h3>Pagamentos registrados</h3>@if (Model.Pagamentos.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Valor</th><th>Observação</th><th>Ação</th></tr></thead><tbody>@foreach (var pag in Model.Pagamentos.OrderByDescending(p => p.DataRecebimento)) { <tr><td>@(pag.DataRecebimento?.ToString("dd/MM/yyyy") ?? "Saldo anterior (data não registrada)")</td><td>@pag.Valor.ToString("C")</td><td>@(string.IsNullOrWhiteSpace(pag.Observacoes) ? "—" : pag.Observacoes)</td><td><form asp-action="ExcluirPagamento" method="post"><input type="hidden" name="id" value="@pag.Id"/><button class="btn btn-sm btn-outline-danger" data-confirm-message="Remover este pagamento?">Remover</button></form></td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum pagamento registrado.</p> }</div></section>
<section id="historico" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Histórico")' />@if (Model.Historico.Any()) { <ul class="list-group process-history-list">@foreach (var item in Model.Historico.OrderByDescending(x => x.CriadoEm).Take(100)) { <li class="list-group-item"><div class="process-history-copy"><strong>@item.Tipo</strong><span>@item.Descricao</span></div><div class="process-history-meta"><time datetime="@item.CriadoEm.ToUniversalTime().ToString("O")">@item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</time><span>@(item.Responsavel ?? "Sistema")</span></div></li> }</ul> } else { <p class="muted mb-0">Nenhum registro no histórico.</p> }</section>


