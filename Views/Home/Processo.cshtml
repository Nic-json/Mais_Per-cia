@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Processo " + Model.Numero; var documentos = Model.Documentos.OrderByDescending(d => d.EnviadoEm).ToList(); }
<header class="page-heading"><div><a asp-action="Processos" class="back-link">Ã¢â€ Â Voltar ÃƒÂ  lista</a><partial name="_PageTitle" model='new PageHeadingViewModel("PROCESSO / PERÃƒÂCIA", $"PerÃƒÂ­cia nÃ‚Âº {Model.Numero}", Model.Status.ToString())' /></div><div class="heading-actions"><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar cadastro</a></div></header>
@if (TempData["MensagemFinanceira"] is string msg) { <div class="alert alert-success">@msg</div> } @if (TempData["ErroFinanceiro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<section id="resumo" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Resumo do processo")' /><div class="row g-3"><div class="col-md-4"><b>NÃƒÂºmero da perÃƒÂ­cia</b><div>@Model.Numero</div></div><div class="col-md-4"><b>Comarca / Vara</b><div>@Model.Comarca / @Model.Vara</div></div><div class="col-md-4"><b>Tipo de perÃƒÂ­cia</b><div>@(Model.TipoPericia ?? "Ã¢â‚¬â€")</div></div><div class="col-md-4"><b>Enviada / aceita</b><div>@Model.DataEnvio?.ToString("dd/MM/yyyy") / @Model.DataAceite?.ToString("dd/MM/yyyy")</div></div><div class="col-md-4"><b>Prazo geral</b><div>@Model.PrazoLaudo?.ToString("dd/MM/yyyy")</div></div><div class="col-12"><b>ObservaÃƒÂ§ÃƒÂµes</b><div>@(Model.Observacoes ?? "Ã¢â‚¬â€")</div></div></div></section>
<section id="periciados" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Periciados")' />@if (TempData["ErroPericiado"] is string erroPessoa) { <div class="alert alert-danger">@erroPessoa</div>}
<details class="mb-4"><summary class="btn btn-outline-secondary">+ Adicionar periciado</summary><form asp-action="AdicionarPericiado" method="post" class="row g-3 mt-1"><input type="hidden" name="id" value="@Model.Id"/><div class="col-md-5"><label class="form-label">Nome</label><input name="nome" class="form-control" maxlength="160" required/></div><div class="col-md-4"><label class="form-label">Telefone</label><input name="telefone" type="tel" class="form-control" maxlength="200" placeholder="(00) 00000-0000"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary">Salvar periciado</button></div><div class="col-12"><label class="form-label">ObservaÃƒÂ§ÃƒÂµes</label><textarea name="observacoes" class="form-control" rows="2" maxlength="4000"></textarea></div></form></details>
@foreach (var pessoa in Model.Periciados) { <div class="border rounded p-3 mb-3"><form asp-action="AtualizarPericiado" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="periciadoId" value="@pessoa.Id"/><div class="row g-3"><div class="col-md-5"><label class="form-label">Nome</label><input name="nome" value="@pessoa.Nome" class="form-control" maxlength="160" required/></div><div class="col-md-4"><label class="form-label">Telefone</label><input name="telefone" value="@pessoa.Contato" type="tel" class="form-control" maxlength="200"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-secondary">Salvar pessoa</button></div><div class="col-12"><label class="form-label">ObservaÃƒÂ§ÃƒÂµes</label><textarea name="observacoes" class="form-control" rows="2" maxlength="4000">@pessoa.RegistroEntrevista</textarea></div></div></form><form asp-action="ExcluirPericiado" method="post" class="mt-2"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="periciadoId" value="@pessoa.Id"/><button class="btn btn-sm btn-outline-danger" data-confirm-message="Excluir este periciado? Laudos vinculados ficarÃƒÂ£o sem associaÃƒÂ§ÃƒÂ£o.">Excluir pessoa</button></form></div> }</section>
<section id="laudos" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Laudos")' />@if (Model.Laudos.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>NÃºmero</th><th>Periciado</th><th>Status</th><th>Prazo</th></tr></thead><tbody>@foreach (var laudo in Model.Laudos.OrderBy(l => l.Id)) { <tr><td>@laudo.NumeroLaudo</td><td>@(laudo.Periciado?.Nome ?? "NÃ£o associado")</td><td>@laudo.Status</td><td>@(laudo.Prazo?.ToString("dd/MM/yyyy") ?? "Sem prazo")</td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum laudo cadastrado.</p> }</section>
<section id="agenda" class="form-panel mb-3"><div class="d-flex justify-content-between"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Agenda e prazos")' /><a asp-action="Agenda" class="action-link">Abrir agenda</a></div><ul>@foreach (var evento in Model.EventosAgenda.Where(e => !e.Cancelado).OrderBy(e => e.Inicio)) { <li>@evento.Inicio.ToString("dd/MM/yyyy HH:mm") Ã‚Â· @evento.Titulo Ã‚Â· @evento.Local</li> } @if (Model.PrazoLaudo.HasValue) { <li>Prazo geral do laudo: @Model.PrazoLaudo.Value.ToString("dd/MM/yyyy")</li> }</ul></section>
<section id="honorarios" class="form-panel process-finance-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Honorários")' /><div class="process-finance-summary"><div><span>Valor fixado</span><strong>@Model.ValorHonorarios.ToString("C")</strong></div><div><span>Total recebido</span><strong>@Model.ValorRecebido.ToString("C")</strong></div><div><span>Saldo a receber</span><strong>@(((decimal)ViewBag.Saldo).ToString("C"))</strong></div></div><div class="process-payment-entry"><div class="process-payment-heading"><h3>Registrar recebimento</h3><p>Informe os dados do pagamento recebido.</p></div><form asp-action="RegistrarPagamento" method="post" class="process-payment-form"><input type="hidden" name="id" value="@Model.Id"/><label>Valor recebido<input type="number" min="0.01" max="@ViewBag.Saldo" step="0.01" name="valor" class="form-control" required/></label><label>Data do recebimento<input type="date" name="dataRecebimento" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></label><label class="process-payment-proof">Comprovante (opcional)<select name="documentoPericiaId" class="form-select"><option value="">Sem comprovante</option>@foreach (var doc in documentos) { <option value="@doc.Id">@doc.NomeOriginal</option> }</select></label><label class="process-payment-note">Observação (opcional)<input name="observacoes" class="form-control" maxlength="2000"/></label><button class="btn btn-primary">Registrar pagamento</button></form></div><div class="process-payment-history"><h3>Pagamentos registrados</h3>@if (Model.Pagamentos.Any()) { <div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Valor</th><th>Observação</th><th>Comprovante</th><th>Ação</th></tr></thead><tbody>@foreach (var pag in Model.Pagamentos.OrderByDescending(p => p.DataRecebimento)) { <tr><td>@(pag.DataRecebimento?.ToString("dd/MM/yyyy") ?? "Saldo anterior (data não registrada)")</td><td>@pag.Valor.ToString("C")</td><td>@(string.IsNullOrWhiteSpace(pag.Observacoes) ? "—" : pag.Observacoes)</td><td>@if (pag.DocumentoPericiaId.HasValue) { <a asp-action="BaixarDocumento" asp-route-id="@pag.DocumentoPericiaId" class="action-link">Baixar</a> } else { <span>—</span> }</td><td><form asp-action="ExcluirPagamento" method="post"><input type="hidden" name="id" value="@pag.Id"/><button class="btn btn-sm btn-outline-danger" data-confirm-message="Remover este pagamento?">Remover</button></form></td></tr> }</tbody></table></div> } else { <p class="muted mb-0">Nenhum pagamento registrado.</p> }</div></section>
<section id="historico" class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Histórico")' /><div class="process-history-entry"><h3>Adicionar atualização</h3><p>Registre uma informação importante sobre este processo.</p><form asp-action="RegistrarAtualizacao" method="post" class="process-history-form"><input type="hidden" name="id" value="@Model.Id"/><textarea name="descricao" class="form-control" rows="2" maxlength="900" required placeholder="Escreva a atualização"></textarea><button class="btn btn-outline-secondary">Adicionar atualização</button></form></div><h3 class="process-history-subtitle">Atualizações do processo</h3>@if (Model.Historico.Any()) { <ol class="list-group list-group-numbered process-history-list">@foreach (var item in Model.Historico.OrderByDescending(x => x.CriadoEm).Take(100)) { <li class="list-group-item"><strong>@item.Tipo</strong><span>@item.Descricao</span><small>@item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(item.Responsavel ?? "Sistema")</small></li> }</ol> } else { <p class="muted mb-0">Nenhuma atualização registrada.</p> }</section>


