@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Visão geral"; string StatusNome(StatusPericia s) => s switch { StatusPericia.AguardandoAceite => "Aguardando aceite", StatusPericia.EmAndamento => "Em andamento", StatusPericia.LaudoEnviado => "Laudo enviado", StatusPericia.AguardandoPagamento => "Aguardando pagamento", StatusPericia.Concluida => "Concluída", StatusPericia.Recusada => "Recusada", _ => "Cancelada" }; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("PAINEL", "Perícias em acompanhamento", "Veja prazos, laudos pendentes e honorários a receber.")' /><div class="heading-actions"><a class="btn btn-outline-secondary" asp-action="Backup">Backup completo</a><a class="btn btn-primary btn-lg" asp-action="Criar">+ Nova perícia</a></div></header>
@if (TempData["Mensagem"] is string mensagem) { <div class="alert alert-success alert-dismissible fade show">@mensagem<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
<div class="stats-grid"><a class="stat-card text-decoration-none" asp-action="Index"><div class="stat-label">CASOS ACOMPANHADOS</div><div class="stat-value">@ViewBag.Total</div><div class="stat-foot">ativos ou com saldo pendente</div></a><a class="stat-card text-decoration-none" asp-action="Laudos" asp-route-status="EmElaboracao"><div class="stat-label">LAUDOS PENDENTES</div><div class="stat-value">@ViewBag.LaudosPendentes</div><div class="stat-foot">ainda não entregues</div></a><a class="stat-card text-decoration-none" asp-action="Index" asp-route-prazoDe="@DateTime.Today.ToString("yyyy-MM-dd")" asp-route-prazoAte="@DateTime.Today.AddDays((int)ViewBag.AntecedenciaPrazoDias).ToString("yyyy-MM-dd")"><div class="stat-label">PRAZOS NOS PRÓXIMOS @ViewBag.AntecedenciaPrazoDias DIAS</div><div class="stat-value">@ViewBag.PrazosProximos</div><div class="stat-foot">@ViewBag.PrazosVencidos já vencidos</div></a><a class="stat-card text-decoration-none" asp-action="Index" asp-route-pagamento="pendente"><div class="stat-label">HONORÁRIOS A RECEBER</div><div class="stat-value money">@(((decimal)ViewBag.HonorariosAReceber).ToString("C"))</div><div class="stat-foot">@ViewBag.AguardandoPagamento casos com saldo</div></a><a class="stat-card text-decoration-none" asp-action="Honorarios"><div class="stat-label">VALOR RECEBIDO</div><div class="stat-value money">@(((decimal)ViewBag.TotalRecebido).ToString("C"))</div><div class="stat-foot">histórico de pagamentos</div></a></div>
<section class="list-panel"><div class="list-heading"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Prioridades", "Prazos mais próximos primeiro; depois, pendências financeiras antigas.")' /><a asp-action="Processos" class="action-link">Todos os processos</a></div>
<form method="get" class="filters"><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por CNJ, perícia, laudo ou periciado" /></div><select name="status" class="form-select"><option value="">Todos os status técnicos</option>@foreach (var s in Enum.GetValues<StatusPericia>()) { <option value="@s" selected="@(ViewBag.StatusFiltro == s)">@StatusNome(s)</option> }</select><select name="comarca" class="form-select"><option value="">Todas as comarcas</option>@foreach (string c in ViewBag.Comarcas) { <option selected="@(ViewBag.ComarcaFiltro == c)">@c</option> }</select><select name="pagamento" class="form-select"><option value="">Qualquer situação financeira</option><option value="pendente" selected="@(ViewBag.Pagamento == "pendente")">Saldo pendente</option><option value="quitado" selected="@(ViewBag.Pagamento == "quitado")">Quitado</option></select><label class="form-label mb-0">Prazo desde <input type="date" name="prazoDe" value="@ViewBag.PrazoDe" class="form-control"/></label><label class="form-label mb-0">Prazo até <input type="date" name="prazoAte" value="@ViewBag.PrazoAte" class="form-control"/></label><button class="btn btn-outline-secondary">Filtrar</button><a asp-action="Index" class="clear-filter">Limpar</a></form>
@if (!Model.Any()) { <div class="empty-state"><h3>Nenhum caso encontrado</h3><p>Cadastre uma perícia ou ajuste os filtros.</p><a asp-action="Criar" class="btn btn-primary">Cadastrar perícia</a></div> }
else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERÍCIA</th><th>PERICIADOS</th><th>LAUDOS</th><th>PRAZO</th><th>HONORÁRIOS / SALDO</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach (var p in Model) { var pendentes = p.Laudos.Count(l => l.Status != StatusLaudo.Entregue); <tr><td><div class="person-name">@(p.NumeroProcesso ?? "CNJ não informado")</div><div class="case-number">Perícia nº @p.Numero · @p.Comarca @p.Vara</div></td><td>@string.Join(", ", p.Periciados.Select(x => x.Nome).DefaultIfEmpty(p.NomePericiado))</td><td>@p.Laudos.Count <span class="case-number">(@pendentes pendentes)</span></td><td class="@(p.PrazoLaudo < DateTime.Today && p.Status != StatusPericia.Concluida ? "text-danger fw-bold" : "")">@(p.PrazoLaudo?.ToString("dd/MM/yyyy") ?? "—")</td><td>@p.ValorHonorarios.ToString("C")<div class="case-number">Saldo @Math.Max(0, p.ValorHonorarios - p.ValorRecebido).ToString("C")</div></td><td>@StatusNome(p.Status)</td><td><a asp-action="Processo" asp-route-id="@p.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div>
<nav aria-label="Paginação"><ul class="pagination">@for (var i = 1; i <= (int)ViewBag.TotalPaginas; i++) { <li class="page-item @(i == (int)ViewBag.Pagina ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-busca="@ViewBag.Busca" asp-route-status="@ViewBag.StatusFiltro" asp-route-comarca="@ViewBag.ComarcaFiltro" asp-route-pagamento="@ViewBag.Pagamento" asp-route-prazoDe="@ViewBag.PrazoDe" asp-route-prazoAte="@ViewBag.PrazoAte" asp-route-pagina="@i">@i</a></li> }</ul></nav> }
</section>
