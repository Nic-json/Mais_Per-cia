@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@using Sistemas_para_pericias.Models
@{
    ViewData["Title"] = "Arquivadas";
    string NomeStatus(StatusPericia s) => s == StatusPericia.Cancelada ? "Cancelada" : "Concluída e paga";
    string ClasseStatus(StatusPericia s) => s == StatusPericia.Cancelada ? "status-cancel" : "status-done";
}
<div class="page-heading"><div><div class="eyebrow">HISTÓRICO</div><h1>Perícias arquivadas</h1><p>Casos concluídos e pagos ou cancelados.</p></div><div class="heading-actions"><a class="btn btn-primary btn-lg" asp-action="Criar">＋ Nova perícia</a></div></div>
<section class="list-panel"><div class="list-heading"><div><h2>Arquivo</h2><span class="muted">@Model.Count() registros nesta busca · @ViewBag.Total no total</span></div></div>
<form method="get" class="filters"><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome ou número..." /></div><button class="btn btn-outline-secondary">Buscar</button>@if (ViewBag.Busca != null) { <a asp-action="Arquivadas" class="clear-filter">Limpar</a> }</form>
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">▤</div><h3>Nenhuma perícia arquivada</h3><p>Perícias concluídas e totalmente pagas ou canceladas aparecerão aqui.</p></div> }
else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PERICIADO / Nº DA PERÍCIA</th><th>DATA DE ENVIO</th><th>HONORÁRIOS</th><th>RECEBIDO</th><th>SITUAÇÃO</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><div class="person-name">@p.NomePericiado</div><div class="case-number">Nº @p.Numero</div></td><td>@(p.DataEnvio?.ToString("dd/MM/yyyy") ?? "—")</td><td class="amount">@p.ValorHonorarios.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td><td class="amount">@p.ValorRecebido.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td><td><span class="status-pill @ClasseStatus(p.Status)"><i></i>@NomeStatus(p.Status)</span></td><td class="actions"><a asp-action="Editar" asp-route-id="@p.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div>}
</section>
