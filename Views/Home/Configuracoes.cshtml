@model Sistemas_para_pericias.Models.ConfiguracaoPerito
@{ ViewData["Title"] = "Configurações"; }
<div class="page-heading"><div><div class="eyebrow">PREFERÊNCIAS</div><h1>Configurações</h1><p>Perfil profissional, avisos do painel e proteção dos dados.</p></div></div>
@if (TempData["MensagemConfiguracao"] is string mensagem) { <div class="alert alert-success">@mensagem</div> }
<form asp-action="SalvarConfiguracoes" method="post" class="form-panel mb-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><h2>Perfil profissional</h2><p class="muted">Informações usadas para organizar o trabalho. O acesso à conta permanece configurado pelo administrador do sistema.</p><div class="row g-3"><div class="col-md-6"><label asp-for="NomeProfissional" class="form-label">Nome do perito</label><input asp-for="NomeProfissional" class="form-control" maxlength="160"/></div><div class="col-md-6"><label asp-for="Especialidade" class="form-label"></label><input asp-for="Especialidade" class="form-control" maxlength="120"/></div><div class="col-md-4"><label asp-for="RegistroProfissional" class="form-label">Registro profissional</label><input asp-for="RegistroProfissional" class="form-control" maxlength="80"/></div><div class="col-md-4"><label asp-for="EmailContato" class="form-label">E-mail para contato</label><input asp-for="EmailContato" type="email" class="form-control" maxlength="200"/></div><div class="col-md-4"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" maxlength="40"/></div></div><hr/><h2>Lembretes de prazo</h2><div class="row g-3 align-items-end"><div class="col-md-4"><label asp-for="AntecedenciaPrazoDias" class="form-label">Avisar no painel com quantos dias</label><input asp-for="AntecedenciaPrazoDias" type="number" min="0" max="60" class="form-control"/><span asp-validation-for="AntecedenciaPrazoDias" class="text-danger"></span></div><div class="col-md-4 form-check ms-3"><input asp-for="AvisarPrazosNoPainel" class="form-check-input"/><label asp-for="AvisarPrazosNoPainel" class="form-check-label">Mostrar contagem de prazos próximos</label></div><div class="col-12"><button class="btn btn-primary">Salvar preferências</button></div></div></form>
<section class="form-panel"><h2>Dados e segurança</h2><p>Conta autenticada: <strong>@ViewBag.EmailConta</strong>. O sistema está configurado para uma conta administradora; não existe separação de dados por usuário.</p><p>Os dados do processo e os anexos são privados após login. Faça backup completo regularmente e mantenha uma cópia fora do servidor.</p><a asp-action="Banco" class="btn btn-outline-secondary">Abrir backup e banco de dados</a></section>
