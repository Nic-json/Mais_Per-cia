@model Sistemas_para_pericias.Models.ConfiguracaoPerito
@{ ViewData["Title"] = "Configurações"; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("PREFERÊNCIAS", "Configurações", "Seu perfil, seus lembretes e seus dados.")' /></header>
@if (TempData["MensagemConfiguracao"] is string mensagem) { <div class="alert alert-success">@mensagem</div> }
<form asp-action="SalvarConfiguracoes" method="post" class="form-panel mb-3">
 <div asp-validation-summary="ModelOnly" class="text-danger"></div><partial name="_PanelTitle" model='new PanelHeadingViewModel("Perfil profissional")' />
 <p class="muted">O perfil é privado nesta conta.</p>
 <div class="row g-3">
  <div class="col-md-6"><label asp-for="NomeProfissional" class="form-label">Nome do perito</label><input asp-for="NomeProfissional" class="form-control" maxlength="160"/></div>
  <div class="col-md-6"><label asp-for="Especialidade" class="form-label"></label><input asp-for="Especialidade" class="form-control" maxlength="120"/></div>
  <div class="col-md-4"><label asp-for="RegistroProfissional" class="form-label">Registro profissional</label><input asp-for="RegistroProfissional" class="form-control" maxlength="80"/></div>
  <div class="col-md-4"><label asp-for="EmailContato" class="form-label">E-mail para contato</label><input asp-for="EmailContato" type="email" class="form-control" maxlength="200"/></div>
  <div class="col-md-4"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" maxlength="40"/></div>
 </div>
 <hr/><partial name="_PanelTitle" model='new PanelHeadingViewModel("Lembretes de prazo")' />
 <div class="row g-3 align-items-end">
  <div class="col-md-4"><label asp-for="AntecedenciaPrazoDias" class="form-label">Avisar no painel com quantos dias</label><input asp-for="AntecedenciaPrazoDias" type="number" min="0" max="60" class="form-control"/><span asp-validation-for="AntecedenciaPrazoDias" class="text-danger"></span></div>
  <div class="col-md-4 form-check ms-3"><input asp-for="AvisarPrazosNoPainel" class="form-check-input"/><label asp-for="AvisarPrazosNoPainel" class="form-check-label">Mostrar contagem de prazos próximos</label></div>
  <div class="col-12"><button class="btn btn-primary">Salvar preferências</button></div>
 </div>
</form>
<section class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Sua conta")' /><p>Conta autenticada: <strong>@ViewBag.EmailConta</strong>. Os registros e arquivos são separados por conta.</p><a asp-controller="Conta" asp-action="AlterarSenha" class="btn btn-outline-secondary">Alterar senha</a></section>
<section class="form-panel"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Exportar seus dados")' /><p>O arquivo inclui apenas os dados e anexos desta conta. Para proteger os dados dos demais clientes, restauração e edição direta do banco não estão disponíveis nesta versão.</p><a asp-action="Backup" class="btn btn-outline-primary">Baixar exportação da conta (.zip)</a></section>
