@model Sistemas_para_pericias.Models.ConfiguracaoPerito
@{ ViewData["Title"] = "Configurações"; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("PREFERÊNCIAS", "Configurações", "Perfil profissional, avisos do painel e proteção dos dados.")' /></header>
@if (TempData["MensagemConfiguracao"] is string mensagem) { <div class="alert alert-success">@mensagem</div> }
<form asp-action="SalvarConfiguracoes" method="post" class="form-panel mb-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><partial name="_PanelTitle" model='new PanelHeadingViewModel("Perfil profissional")' /><p class="muted">Informações usadas para organizar o trabalho. O acesso à conta permanece configurado pelo administrador do sistema.</p><div class="row g-3"><div class="col-md-6"><label asp-for="NomeProfissional" class="form-label">Nome do perito</label><input asp-for="NomeProfissional" class="form-control" maxlength="160"/></div><div class="col-md-6"><label asp-for="Especialidade" class="form-label"></label><input asp-for="Especialidade" class="form-control" maxlength="120"/></div><div class="col-md-4"><label asp-for="RegistroProfissional" class="form-label">Registro profissional</label><input asp-for="RegistroProfissional" class="form-control" maxlength="80"/></div><div class="col-md-4"><label asp-for="EmailContato" class="form-label">E-mail para contato</label><input asp-for="EmailContato" type="email" class="form-control" maxlength="200"/></div><div class="col-md-4"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" maxlength="40"/></div></div><hr/><partial name="_PanelTitle" model='new PanelHeadingViewModel("Lembretes de prazo")' /><div class="row g-3 align-items-end"><div class="col-md-4"><label asp-for="AntecedenciaPrazoDias" class="form-label">Avisar no painel com quantos dias</label><input asp-for="AntecedenciaPrazoDias" type="number" min="0" max="60" class="form-control"/><span asp-validation-for="AntecedenciaPrazoDias" class="text-danger"></span></div><div class="col-md-4 form-check ms-3"><input asp-for="AvisarPrazosNoPainel" class="form-check-input"/><label asp-for="AvisarPrazosNoPainel" class="form-check-label">Mostrar contagem de prazos próximos</label></div><div class="col-12"><button class="btn btn-primary">Salvar preferências</button></div></div></form>
<section class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Dados e segurança")' /><p>Conta autenticada: <strong>@ViewBag.EmailConta</strong>. O sistema está configurado para uma conta administradora.</p><p>Os dados dos processos e anexos são privados após login. Mantenha um backup completo fora do servidor.</p></section>
<partial name="_PanelTitle" model='new PanelHeadingViewModel("Backup e banco de dados")' />
<partial name="_BancoDados" />
