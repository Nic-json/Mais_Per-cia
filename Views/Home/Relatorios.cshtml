@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@{ ViewData["Title"] = "Relatórios"; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("GESTÃO", "Relatórios", "Resumo de processos e honorários por período de envio.")' /></header>
<section class="form-panel mb-3"><form method="get" class="row g-3 align-items-end"><div class="col-md-2"><label class="form-label">De</label><input type="date" name="inicio" value="@ViewBag.Inicio" class="form-control"/></div><div class="col-md-2"><label class="form-label">Até</label><input type="date" name="fim" value="@ViewBag.Fim" class="form-control"/></div><div class="col-md-3"><label class="form-label">Comarca</label><select name="comarca" class="form-select"><option value="">Todas</option>@foreach (string c in ViewBag.Comarcas) { <option selected="@(ViewBag.ComarcaFiltro == c)">@c</option> }</select></div><div class="col-md-2"><label class="form-label">Vara</label><select name="vara" class="form-select"><option value="">Todas</option>@foreach (string v in ViewBag.Varas) { <option selected="@(ViewBag.VaraFiltro == v)">@v</option> }</select></div><div class="col-md-2"><label class="form-label">Tipo</label><select name="tipo" class="form-select"><option value="">Todos</option>@foreach (string t in ViewBag.Tipos) { <option selected="@(ViewBag.TipoFiltro == t)">@t</option> }</select></div><div class="col-md-1"><button class="btn btn-primary">Atualizar</button></div></form></section>
<div class="stats-grid"><div class="stat-card"><div class="stat-label">PROCESSOS NO PERÍODO</div><div class="stat-value">@ViewBag.TotalProcessos</div></div><div class="stat-card"><div class="stat-label">FIXADOS</div><div class="stat-value money">@(((decimal)ViewBag.HonorariosFixados).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">SOLICITADOS</div><div class="stat-value money">@(((decimal)ViewBag.HonorariosSolicitados).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">LIBERADOS</div><div class="stat-value money">@(((decimal)ViewBag.HonorariosLiberados).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">RECEBIDOS</div><div class="stat-value money">@(((decimal)ViewBag.Recebido).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">A RECEBER</div><div class="stat-value money">@(((decimal)ViewBag.AReceber).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">ENTREGA ATÉ PAGAMENTO</div><div class="stat-value">@(ViewBag.MediaDiasPagamento is double dias ? $"{dias:0} dias" : "—")</div><div class="stat-foot">com dados disponíveis</div></div></div>
<section class="list-panel"><div class="list-heading"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Detalhamento")' /><div class="panel-heading-actions"><button type="button" class="btn btn-outline-secondary" onclick="window.print()">Imprimir / salvar PDF</button><a class="btn btn-outline-secondary" asp-action="ExportarRelatorio" asp-route-inicio="@ViewBag.Inicio" asp-route-fim="@ViewBag.Fim" asp-route-comarca="@ViewBag.ComarcaFiltro" asp-route-vara="@ViewBag.VaraFiltro" asp-route-tipo="@ViewBag.TipoFiltro">Exportar CSV</a></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Número</th><th>Comarca / Vara / Tipo</th><th>Enviada</th><th>Honorários</th><th>Recebido</th><th>Saldo</th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><a asp-action="Processo" asp-route-id="@p.Id">@(p.NumeroProcesso ?? p.Numero)</a></td><td>@p.Comarca / @p.Vara · @p.TipoPericia</td><td>@p.DataEnvio?.ToString("dd/MM/yyyy")</td><td>@p.ValorHonorarios.ToString("C")</td><td>@p.ValorRecebido.ToString("C")</td><td>@Math.Max(0, p.ValorHonorarios - p.ValorRecebido).ToString("C")</td></tr> }</tbody></table></div></section>
<style>
@@media print { .sidebar, .topbar, .footer, .heading-actions, .filters, form, button { display: none !important; } .main-area, .content-wrap, .list-panel { width: 100% !important; margin: 0 !important; padding: 0 !important; box-shadow: none !important; border: 0 !important; } body { background: white !important; } }
</style>
