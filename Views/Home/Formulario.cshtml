@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = Model.Id == 0 ? "Nova perícia" : "Editar perícia"; var editar = Model.Id != 0; }
<header class="page-heading"><div><a asp-action="Index" class="back-link">← Voltar para perícias</a><partial name="_PageTitle" model='new PageHeadingViewModel("CADASTRO", editar ? "Editar perícia" : "Nova perícia", "Preencha os dados para organizar o acompanhamento.")' /></div></header>
@if (TempData["Mensagem"] is string mensagemDocumento) { <div class="alert alert-success">@mensagemDocumento</div> }
@if (TempData["Erro"] is string erroDocumento) { <div class="alert alert-danger">@erroDocumento</div> }
<form asp-action="@(editar ? "Editar" : "Criar")" asp-route-id="@Model.Id" method="post" class="form-panel">
 @if (!editar && ViewBag.AbrirLaudoDepois is true) { <input type="hidden" name="abrirLaudoDepois" value="true" /> }
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="form-section-title"><span>01</span><div><h2>Identificação</h2><p>Informações do processo pericial.</p></div></div>
 <div class="row g-3">
  <div class="col-md-7"><label asp-for="NomePericiado" class="form-label">Periciado principal</label><input asp-for="NomePericiado" class="form-control" placeholder="Nome completo" /><span asp-validation-for="NomePericiado" class="text-danger"></span></div>
  <div class="col-md-5"><label asp-for="Numero" class="form-label"></label><input asp-for="Numero" class="form-control" placeholder="Ex.: 0001234-56.2025" /><span asp-validation-for="Numero" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="NumeroProcesso" class="form-label"></label><input asp-for="NumeroProcesso" class="form-control" placeholder="Número CNJ, se disponível" /></div>
  <div class="col-md-6"><label asp-for="TipoPericia" class="form-label"></label><input asp-for="TipoPericia" class="form-control" placeholder="Ex.: médica, contábil, engenharia" /></div>
  <div class="col-md-4"><label asp-for="Comarca" class="form-label"></label><input asp-for="Comarca" class="form-control" /></div>
  <div class="col-md-4"><label asp-for="Vara" class="form-label"></label><input asp-for="Vara" class="form-control" /></div>
  <div class="col-md-4"><label asp-for="Magistrado" class="form-label"></label><input asp-for="Magistrado" class="form-control" /></div>
  <div class="col-12"><label asp-for="OutrosPericiados" class="form-label">Outros periciados</label><textarea asp-for="OutrosPericiados" class="form-control" rows="3" placeholder="Digite um nome por linha"></textarea><div class="form-text">Você pode cadastrar até 50 periciados nesta perícia.</div><span asp-validation-for="OutrosPericiados" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataEnvio" class="form-label"></label><input asp-for="DataEnvio" class="form-control" /><span asp-validation-for="DataEnvio" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataAceite" class="form-label"></label><input asp-for="DataAceite" class="form-control" /><span asp-validation-for="DataAceite" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="PrazoLaudo" class="form-label"></label><input asp-for="PrazoLaudo" class="form-control" /><span asp-validation-for="PrazoLaudo" class="text-danger"></span></div>
 </div>
 <div class="form-section-title section-spacer"><span>02</span><div><h2>Financeiro e andamento</h2><p>Valores, pagamento e status atual.</p></div></div>
 <div class="row g-3">
  <div class="col-md-4"><label asp-for="ValorHonorarios" class="form-label"></label><div class="input-group"><span class="input-group-text">R$</span><input asp-for="ValorHonorarios" class="form-control" type="number" step="0.01" min="0" /></div><span asp-validation-for="ValorHonorarios" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataHonorariosFixados" class="form-label"></label><input asp-for="DataHonorariosFixados" class="form-control" /></div>
  <div class="col-md-4"><label asp-for="ValorHonorariosSolicitados" class="form-label"></label><div class="input-group"><span class="input-group-text">R$</span><input asp-for="ValorHonorariosSolicitados" class="form-control" type="number" step="0.01" min="0" /></div><span asp-validation-for="ValorHonorariosSolicitados" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataHonorariosSolicitados" class="form-label"></label><input asp-for="DataHonorariosSolicitados" class="form-control" /></div>
  <div class="col-md-4"><label asp-for="ValorHonorariosLiberados" class="form-label"></label><div class="input-group"><span class="input-group-text">R$</span><input asp-for="ValorHonorariosLiberados" class="form-control" type="number" step="0.01" min="0" /></div><span asp-validation-for="ValorHonorariosLiberados" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataHonorariosLiberados" class="form-label"></label><input asp-for="DataHonorariosLiberados" class="form-control" /></div>
  <div class="col-md-4"><label class="form-label">Valor recebido</label><div class="form-control-plaintext fw-semibold">@Model.ValorRecebido.ToString("C")</div><div class="form-text">Registre novos pagamentos na aba Honorários ou no processo.</div></div>
  <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusPericia>()" class="form-select"></select></div>
  <div class="col-12"><label asp-for="Observacoes" class="form-label"></label><textarea asp-for="Observacoes" class="form-control" rows="4" placeholder="Anotações importantes, contatos ou detalhes..."></textarea><span asp-validation-for="Observacoes" class="text-danger"></span></div>
 </div>
 <div class="form-actions"><button type="submit" class="btn btn-primary btn-lg">@(editar ? "Salvar alterações" : "Cadastrar perícia")</button><a asp-action="Index" class="btn btn-light btn-lg">Cancelar</a>@if (editar) { <button type="submit" form="delete-form" class="btn btn-link text-danger ms-auto" onclick="return confirm('Remover esta perícia? Esta ação não pode ser desfeita.')">Excluir perícia</button> }</div>
</form>
@if (editar) { <form id="delete-form" asp-action="Excluir" asp-route-id="@Model.Id" method="post"></form> }
@if (editar)
{
 <section class="form-panel mt-4">
  <div class="form-section-title"><span>03</span><div><h2>Laudos desta perícia</h2><p>Cadastre vários laudos, cada um com seu número e periciado relacionado.</p></div></div>
  @if (Model.Laudos.Count > 0)
  {
   <div class="table-responsive mb-4"><table class="table align-middle"><thead><tr><th>Número do laudo</th><th>Periciado</th><th>Última alteração</th><th></th></tr></thead><tbody>
   @foreach (var laudo in Model.Laudos.OrderBy(l => l.NumeroLaudo))
   {
    <tr><td><strong>@laudo.NumeroLaudo</strong></td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td>@(string.IsNullOrWhiteSpace(laudo.ConteudoHtml) ? "Rascunho vazio" : laudo.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td><td class="text-end"><a asp-action="EditorLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id" class="action-link">@(string.IsNullOrWhiteSpace(laudo.ConteudoHtml) ? "Escrever" : "Abrir")</a><form asp-action="ExcluirLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id" method="post" class="d-inline"><button type="submit" class="btn btn-link text-danger p-0 ms-3" onclick="return confirm('Excluir este laudo?')">Excluir</button></form></td></tr>
   }
   </tbody></table></div>
  }
  else { <p class="muted">Nenhum laudo cadastrado nesta perícia.</p> }
  <form asp-action="CriarLaudo" asp-route-periciaId="@Model.Id" method="post" class="row g-3 align-items-end">
   <div class="col-md-4"><label class="form-label" for="numeroLaudo">Número do laudo</label><input id="numeroLaudo" name="numeroLaudo" class="form-control" maxlength="80" required placeholder="Ex.: 1, 2 ou 0001-A" /></div>
   <div class="col-md-5"><label class="form-label" for="periciadoId">Periciado relacionado</label><select id="periciadoId" name="periciadoId" class="form-select"><option value="">Sem associação</option>@foreach (var pessoa in Model.Periciados.OrderBy(p => p.Nome)) { <option value="@pessoa.Id">@pessoa.Nome</option> }</select></div>
   <div class="col-md-3"><button type="submit" class="btn btn-primary">＋ Criar laudo</button></div>
  </form>
 </section>
 <section class="form-panel document-panel mt-4">
  <div class="form-section-title"><span>04</span><div><h2>Laudos e documentos</h2><p>Arquivos privados desta perícia, acessíveis apenas após login.</p></div></div>
  <form asp-action="AnexarDocumento" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
   <div class="col-md-8"><label for="arquivo" class="form-label">Selecionar arquivo</label><input id="arquivo" name="arquivo" type="file" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required /><div class="form-text">PDF, Word (DOC/DOCX), JPG ou PNG. Limite de 25 MB por arquivo.</div></div>
   <div class="col-md-4"><button type="submit" class="btn btn-primary">Anexar documento</button></div>
  </form>
  @if (Model.Documentos.Count > 0)
  {
   <div class="table-responsive mt-4"><table class="table align-middle"><thead><tr><th>Arquivo</th><th>Tamanho</th><th>Adicionado</th><th>Ações</th></tr></thead><tbody>
   @foreach (var documento in Model.Documentos.OrderByDescending(d => d.EnviadoEm))
   {
    <tr><td>@documento.NomeOriginal</td><td>@((documento.TamanhoBytes / 1048576d).ToString("0.##")) MB</td><td>@documento.EnviadoEm.ToString("dd/MM/yyyy")</td><td><a asp-action="BaixarDocumento" asp-route-id="@documento.Id" class="action-link">Baixar</a><form asp-action="ExcluirDocumento" asp-route-id="@documento.Id" method="post" class="d-inline"><button type="submit" class="btn btn-link text-danger p-0 ms-3" onclick="return confirm('Excluir este arquivo?')">Excluir</button></form></td></tr>
   }
   </tbody></table></div>
  }
  else { <p class="muted mt-4 mb-0">Nenhum documento anexado ainda.</p> }
 </section>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
