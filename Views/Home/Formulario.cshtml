@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = Model.Id == 0 ? "Nova perícia" : "Editar perícia"; var editar = Model.Id != 0; }
<header class="page-heading"><div><a asp-action="Index" class="back-link">← Voltar para perícias</a><partial name="_PageTitle" model='new PageHeadingViewModel("CADASTRO", editar ? "Editar perícia" : "Nova perícia", "Preencha os dados para organizar o acompanhamento.")' /></div></header>
@if (TempData["Mensagem"] is string mensagemDocumento) { <div class="alert alert-success">@mensagemDocumento</div> }
@if (TempData["Erro"] is string erroDocumento) { <div class="alert alert-danger">@erroDocumento</div> }
<form asp-action="@(editar ? "Editar" : "Criar")" asp-route-id="@Model.Id" method="post" class="form-panel pericia-form" data-catalogo-foros="@ViewBag.CatalogoForosJson">
 @if (!editar && ViewBag.AbrirLaudoDepois is true) { <input type="hidden" name="abrirLaudoDepois" value="true" /> }
 <div asp-validation-summary="All" class="text-danger"></div>
 <input asp-for="DataHonorariosFixados" type="hidden" /><input asp-for="ValorHonorariosSolicitados" type="hidden" /><input asp-for="DataHonorariosSolicitados" type="hidden" />
 <input asp-for="ValorHonorariosLiberados" type="hidden" /><input asp-for="DataHonorariosLiberados" type="hidden" />
 <div class="form-section-title"><span>01</span><div><h2>Identificação</h2><p>Informações do processo pericial.</p></div></div>
  <div class="row g-3 pericia-fields">
  <div class="col-12"><label asp-for="Numero" class="form-label"></label><input asp-for="Numero" class="form-control" placeholder="Ex.: 0001234-56.2025" /><span asp-validation-for="Numero" class="text-danger"></span></div>

  <div class="col-md-4"><label asp-for="Comarca" class="form-label"></label><input asp-for="Comarca" data-searchable-combobox="true" class="form-control" /><div class="form-text">No TJRS, o código final reconhecido preenche este campo automaticamente. Você pode pesquisar, ajustar ou digitar outro nome.</div></div>
  <div class="col-md-4"><label asp-for="Vara" class="form-label"></label><input asp-for="Vara" class="form-control" /></div>
  <div class="col-12">
   <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><div><label class="form-label mb-0">Periciados <span class="text-muted fw-normal">(opcional)</span></label><div class="form-text">A perícia pode ser cadastrada sem periciados. Você pode adicionar até 50 pessoas.</div></div><button type="button" id="adicionar-periciado" class="btn btn-outline-secondary">+ Adicionar periciado</button></div>
   <div asp-validation-for="Periciados" class="text-danger"></div>
   <div id="periciados-container" class="d-grid gap-3">
    @for (var i = 0; i < Model.Periciados.Count; i++)
    {
     var pessoa = Model.Periciados[i];
     <div class="border rounded p-3 periciado-item">
      <input type="hidden" name="Periciados[@i].Id" value="@(pessoa.Id == 0 ? "" : pessoa.Id.ToString())" />
      <div class="row g-3 align-items-start">
       <div class="col-md-5"><label class="form-label" for="Periciados_@(i)__Nome">Nome</label><input id="Periciados_@(i)__Nome" name="Periciados[@i].Nome" value="@pessoa.Nome" class="form-control" maxlength="160" required/><span class="text-danger" data-valmsg-for="Periciados[@i].Nome"></span></div>
       <div class="col-md-4"><label class="form-label" for="Periciados_@(i)__Telefone">Telefone</label><input id="Periciados_@(i)__Telefone" name="Periciados[@i].Telefone" value="@pessoa.Contato" type="tel" class="form-control" maxlength="200" placeholder="(00) 00000-0000"/><span class="text-danger" data-valmsg-for="Periciados[@i].Telefone"></span></div>
       <div class="col-md-3 d-flex justify-content-md-end"><button type="button" class="btn btn-sm btn-outline-danger remover-periciado">Remover</button></div>
       <div class="col-12"><label class="form-label" for="Periciados_@(i)__Observacoes">Observações</label><textarea id="Periciados_@(i)__Observacoes" name="Periciados[@i].Observacoes" class="form-control" rows="2" maxlength="4000">@pessoa.RegistroEntrevista</textarea><span class="text-danger" data-valmsg-for="Periciados[@i].Observacoes"></span></div>
      </div>
     </div>
    }
   </div>
   <template id="modelo-periciado"><div class="border rounded p-3 periciado-item"><input type="hidden" name="Periciados[__index__].Id" value=""/><div class="row g-3 align-items-start"><div class="col-md-5"><label class="form-label" for="Periciados___index____Nome">Nome</label><input id="Periciados___index____Nome" name="Periciados[__index__].Nome" class="form-control" maxlength="160" required/><span class="text-danger" data-valmsg-for="Periciados[__index__].Nome"></span></div><div class="col-md-4"><label class="form-label" for="Periciados___index____Telefone">Telefone</label><input id="Periciados___index____Telefone" name="Periciados[__index__].Telefone" type="tel" class="form-control" maxlength="200" placeholder="(00) 00000-0000"/><span class="text-danger" data-valmsg-for="Periciados[__index__].Telefone"></span></div><div class="col-md-3 d-flex justify-content-md-end"><button type="button" class="btn btn-sm btn-outline-danger remover-periciado">Remover</button></div><div class="col-12"><label class="form-label" for="Periciados___index____Observacoes">Observações</label><textarea id="Periciados___index____Observacoes" name="Periciados[__index__].Observacoes" class="form-control" rows="2" maxlength="4000"></textarea><span class="text-danger" data-valmsg-for="Periciados[__index__].Observacoes"></span></div></div></div></template>
  </div>
  <div class="col-12"><label asp-for="Observacoes" class="form-label"></label><textarea asp-for="Observacoes" class="form-control" rows="4"></textarea><span asp-validation-for="Observacoes" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="DataAceite" class="form-label"></label><input asp-for="DataAceite" class="form-control" /><span asp-validation-for="DataAceite" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="PrazoLaudo" class="form-label"></label><input asp-for="PrazoLaudo" class="form-control" /><span asp-validation-for="PrazoLaudo" class="text-danger"></span></div>
 </div>
 <div class="form-section-title section-spacer"><span>02</span><div><h2>Financeiro e andamento</h2><p>Valores, pagamento e status atual.</p></div></div>
  <div class="row g-3 pericia-fields">
  <div class="col-md-4"><label asp-for="ValorHonorarios" class="form-label"></label><div class="input-group"><span class="input-group-text">R$</span><input asp-for="ValorHonorarios" class="form-control" type="number" step="0.01" min="0" /></div><span asp-validation-for="ValorHonorarios" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusPericia>()" class="form-select"></select></div>
  <div class="col-md-4"><label class="form-label" for="DataEnvio">Data do SEI</label><input asp-for="DataEnvio" class="form-control" /><span asp-validation-for="DataEnvio" class="text-danger"></span></div>
  <div class="col-12"><label class="form-label">Pagamentos</label><div class="form-control-plaintext fw-semibold">Total recebido: @Model.ValorRecebido.ToString("C")</div>@if (Model.Pagamentos.Count > 0) { <div class="d-grid gap-1">@foreach (var pagamento in Model.Pagamentos.OrderByDescending(p => p.DataRecebimento)) { <div class="form-control-plaintext">@(pagamento.DataRecebimento?.ToString("dd/MM/yyyy") ?? "Data n&#227;o informada") · @pagamento.Valor.ToString("C")</div> }</div> } else { <div class="form-text">Nenhum pagamento detalhado registrado.</div> }@if (editar) { <a asp-action="Processo" asp-route-id="@Model.Id" asp-fragment="honorarios" class="action-link">Gerenciar pagamentos</a> }</div>
 </div>
 <div class="form-actions"><button type="submit" class="btn btn-primary btn-lg">@(editar ? "Salvar alterações" : "Cadastrar perícia")</button><a asp-action="Index" class="btn btn-light btn-lg">Cancelar</a>@if (editar) { <button type="submit" form="delete-form" class="btn btn-link text-danger ms-auto" onclick="return confirm('Remover esta perícia? Esta ação não pode ser desfeita.')">Excluir perícia</button> }</div>
</form>
@if (editar) { <form id="delete-form" asp-action="Excluir" asp-route-id="@Model.Id" method="post"></form> }
@if (editar)
{
 <section class="form-panel mt-4">
  <div class="form-section-title"><span>03</span><div><h2>Laudos desta perícia</h2><p>Cada laudo recebe número sequencial automático; associe a pessoa correspondente.</p></div></div>
  @if (Model.Laudos.Count > 0)
  {
   <div class="table-responsive mb-4"><table class="table align-middle"><thead><tr><th>Número do laudo</th><th>Periciado</th><th>Última alteração</th><th></th></tr></thead><tbody>
   @foreach (var laudo in Model.Laudos.OrderBy(l => l.Id))
   {
    <tr><td><strong>@laudo.NumeroLaudo</strong></td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td>@(string.IsNullOrWhiteSpace(laudo.ConteudoHtml) ? "Rascunho vazio" : laudo.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td><td class="text-end"><a asp-action="EditorLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id" class="action-link">@(string.IsNullOrWhiteSpace(laudo.ConteudoHtml) ? "Escrever" : "Abrir")</a><form asp-action="ExcluirLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id" method="post" class="d-inline"><button type="submit" class="btn btn-link text-danger p-0 ms-3" onclick="return confirm('Excluir este laudo?')">Excluir</button></form></td></tr>
   }
   </tbody></table></div>
  }
  else { <p class="muted">Nenhum laudo cadastrado nesta perícia.</p> }
  <form asp-action="CriarLaudo" asp-route-periciaId="@Model.Id" method="post" class="row g-3 align-items-end">
      <div class="col-md-8"><label class="form-label" for="periciadoId">Periciado relacionado</label><select id="periciadoId" name="periciadoId" class="form-select"><option value="">Sem associação</option>@foreach (var pessoa in Model.Periciados.OrderBy(p => p.Nome)) { <option value="@pessoa.Id">@pessoa.Nome</option> }</select></div>
   <div class="col-md-4"><button type="submit" class="btn btn-primary">＋ Criar laudo</button></div>
  </form>
 </section>
 <section class="form-panel document-panel mt-4">
  <div class="form-section-title"><span>04</span><div><h2>Laudos e documentos</h2><p>Arquivos privados desta perícia, acessíveis apenas após login.</p></div></div>
  <form asp-action="AnexarDocumento" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
   <div class="col-md-8"><label for="arquivo" class="form-label">Selecionar arquivo</label><input id="arquivo" name="arquivo" type="file" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required /><div class="form-text">PDF, Word (DOC/DOCX), JPG ou PNG. Limite de 25 MB por arquivo.</div></div>
   <div class="col-md-4"><button type="submit" class="btn btn-primary">Anexar documento</button></div>
  </form>
  @if (Model.Documentos.Count > 0)
  {
   <div class="table-responsive mt-4"><table class="table align-middle"><thead><tr><th>Arquivo</th><th>Tamanho</th><th>Adicionado</th><th>Ações</th></tr></thead><tbody>
   @foreach (var documento in Model.Documentos.OrderByDescending(d => d.EnviadoEm))
   {
    <tr><td>@documento.NomeOriginal</td><td>@((documento.TamanhoBytes / 1048576d).ToString("0.##")) MB</td><td>@documento.EnviadoEm.ToString("dd/MM/yyyy")</td><td><a asp-action="BaixarDocumento" asp-route-id="@documento.Id" class="action-link">Baixar</a><form asp-action="ExcluirDocumento" asp-route-id="@documento.Id" method="post" class="d-inline"><button type="submit" class="btn btn-link text-danger p-0 ms-3" onclick="return confirm('Excluir este arquivo?')">Excluir</button></form></td></tr>
   }
   </tbody></table></div>
  }
  else { <p class="muted mt-4 mb-0">Nenhum documento anexado ainda.</p> }
 </section>
}
@section Scripts {
 <partial name="_ValidationScriptsPartial" />
 <script>
  (() => {
   const cadastro = document.querySelector('form[data-catalogo-foros]');
   if (cadastro) {
    const catalogo = JSON.parse(cadastro.dataset.catalogoForos || '{}');
    const numero = cadastro.querySelector('#Numero');
    const comarca = cadastro.querySelector('#Comarca');
    let comarcaPreenchidaPeloCodigo = '';
    const preencherComarca = () => {
     const codigo = numero?.value.match(/\.8\.21\.(\d{4})(?:\/RS)?$/i)?.[1];
     const nome = codigo ? catalogo[codigo] : null;
     if (!nome || (comarca?.value && comarca.value !== comarcaPreenchidaPeloCodigo)) return;
     comarca.value = nome;
     comarcaPreenchidaPeloCodigo = nome;
    };
    numero?.addEventListener('input', preencherComarca);
    if (!comarca?.value) preencherComarca();
   }
   const container = document.getElementById('periciados-container');
   const template = document.getElementById('modelo-periciado');
   const addButton = document.getElementById('adicionar-periciado');
   if (!container || !template || !addButton) return;
   const renumber = () => container.querySelectorAll('.periciado-item').forEach((item, index) => {
    item.querySelectorAll('[name]').forEach(el => el.name = el.name.replace(/Periciados\[\d+\]/g, `Periciados[${index}]`));
    item.querySelectorAll('[id]').forEach(el => el.id = el.id.replace(/Periciados_\d+__/g, `Periciados_${index}__`));
    item.querySelectorAll('[for]').forEach(el => el.htmlFor = el.htmlFor.replace(/Periciados_\d+__/g, `Periciados_${index}__`));
    item.querySelectorAll('[data-valmsg-for]').forEach(el => el.dataset.valmsgFor = el.dataset.valmsgFor.replace(/Periciados\[\d+\]/g, `Periciados[${index}]`));
   });
   addButton.addEventListener('click', () => {
    if (container.querySelectorAll('.periciado-item').length >= 50) return;
    const index = container.querySelectorAll('.periciado-item').length;
    const html = template.innerHTML.replaceAll('__index__', String(index));
    container.insertAdjacentHTML('beforeend', html);
    container.lastElementChild?.querySelector('input[name$=".Nome"]')?.focus();
   });
   container.addEventListener('click', event => {
    const button = event.target.closest('.remover-periciado');
    if (!button) return;
    button.closest('.periciado-item')?.remove();
    renumber();
   });
  })();
 </script>
}
