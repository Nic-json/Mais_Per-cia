@model IEnumerable<Sistemas_para_pericias.Models.EventoAgenda>
@{
    ViewData["Title"] = "Agenda";
    var inicioPeriodo = (DateTime)ViewBag.InicioAgenda;
    var fimPeriodo = (DateTime)ViewBag.FimAgenda;
    var modo = (string)ViewBag.Modo;
    var diasAgenda = (IReadOnlyList<Sistemas_para_pericias.Models.AgendaCalendarDayViewModel>)ViewBag.DiasAgenda;
    var diasSemana = new[] { "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado", "Domingo" };
}
<header class="page-heading">
    <partial name="_PageTitle" model='new PageHeadingViewModel("COMPROMISSOS E PRAZOS", "Agenda", "Compromissos vinculados às perícias.")' />
    <div class="heading-actions agenda-period-navigation">
        <a class="btn btn-outline-secondary" asp-action="Agenda" asp-route-data="@(((DateTime)ViewBag.Anterior).ToString("yyyy-MM-dd"))" asp-route-modo="@modo">← Anterior</a>
        <strong>@ViewBag.TituloPeriodo</strong>
        <a class="btn btn-outline-secondary" asp-action="Agenda" asp-route-data="@(((DateTime)ViewBag.Proximo).ToString("yyyy-MM-dd"))" asp-route-modo="@modo">Próximo →</a>
    </div>
</header>
<form method="get" class="filters agenda-period-filter mb-3">
    <select name="modo" class="form-select"><option value="mes" selected="@(modo == "mes")">Mês</option><option value="semana" selected="@(modo == "semana")">Semana</option><option value="dia" selected="@(modo == "dia")">Dia</option></select>
    <input type="date" name="data" value="@inicioPeriodo.ToString("yyyy-MM-dd")" class="form-control" />
    <button class="btn btn-outline-secondary">Ir</button>
</form>
@if (TempData["MensagemAgenda"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (TempData["ErroAgenda"] is string erro) { <div class="alert alert-danger">@erro</div> }
<section class="list-panel agenda-calendar-section mb-3" aria-label="Calendário da agenda">
    @if (modo == "mes")
    {
        <div class="agenda-calendar-weekdays" aria-hidden="true">
            @foreach (var diaSemana in diasSemana) { <div>@diaSemana</div> }
        </div>
    }
    <div class="agenda-calendar-grid @(modo == "dia" ? "agenda-calendar-grid--day" : "")">
        @foreach (var dia in diasAgenda)
        {
            <article class="agenda-calendar-day @(dia.DentroDoPeriodo ? "" : "agenda-calendar-day--muted") @(dia.Hoje ? "agenda-calendar-day--today" : "")">
                <div class="agenda-calendar-day-heading"><time datetime="@dia.Data.ToString("yyyy-MM-dd")">@dia.Data.Day</time><span>@dia.Data.ToString(modo == "mes" ? "ddd" : "dddd", new System.Globalization.CultureInfo("pt-BR"))</span></div>
                <div class="agenda-calendar-items">
                    @foreach (var item in dia.Itens.Take(4))
                    {
                        if (item.EventoId is int eventoId)
                        {
                            <a class="agenda-calendar-event agenda-calendar-event--@item.Categoria" href="#compromisso-@eventoId" title="@item.Titulo — @item.NumeroPericia">
                                @if (!string.IsNullOrWhiteSpace(item.Hora)) { <time>@item.Hora</time> }
                                <span>@item.Titulo</span>
                                @if (!string.IsNullOrWhiteSpace(item.NumeroPericia)) { <small>@item.NumeroPericia</small> }
                            </a>
                        }
                        else
                        {
                            <div class="agenda-calendar-event agenda-calendar-event--@item.Categoria" title="@item.Titulo — @item.NumeroPericia">
                                @if (!string.IsNullOrWhiteSpace(item.Hora)) { <time>@item.Hora</time> }
                                <span>@item.Titulo</span>
                                @if (!string.IsNullOrWhiteSpace(item.NumeroPericia)) { <small>@item.NumeroPericia</small> }
                            </div>
                        }
                    }
                    @if (dia.Itens.Count > 4) { <span class="agenda-calendar-more">+ @(dia.Itens.Count - 4) eventos</span> }
                </div>
            </article>
        }
    </div>
</section>
<section class="form-panel mb-3">
    <partial name="_PanelTitle" model='new PanelHeadingViewModel("Novo compromisso")' />
    <form asp-action="CriarEvento" method="post" class="row g-3 align-items-end">
        <div class="col-md-4"><label class="form-label">Processo/perícia</label><select name="periciaId" class="form-select" required>@foreach (var p in ViewBag.Pericias) { <option value="@p.Id">@p.Numero</option> }</select></div>
        <div class="col-md-4"><label class="form-label">Título</label><input name="titulo" class="form-control" maxlength="160" required placeholder="Entrevista, avaliação..." /></div>
        <div class="col-md-2"><label class="form-label">Início</label><input type="datetime-local" name="inicio" class="form-control" required /></div>
        <div class="col-md-2"><label class="form-label">Fim</label><input type="datetime-local" name="fim" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Periciado</label><select name="periciadoId" class="form-select"><option value="">Sem vínculo individual</option>@foreach (var pessoa in ViewBag.Pessoas) { <option value="@pessoa.Id" data-pericia="@pessoa.PericiaId">@pessoa.Nome</option> }</select></div>
        <div class="col-md-3"><label class="form-label">Local</label><input name="local" class="form-control" maxlength="240" /></div>
        <div class="col-md-2"><label class="form-label">Modalidade</label><select name="modalidade" class="form-select"><option value="">Não definida</option><option>Presencial</option><option>Online</option><option>Telefone</option></select></div>
        <div class="col-md-3"><label class="form-label">Observações</label><input name="observacoes" class="form-control" maxlength="2000" /></div>
        <div class="col-md-1"><button class="btn btn-primary">Adicionar</button></div>
    </form>
</section>
<section class="list-panel">
    <partial name="_PanelTitle" model='new PanelHeadingViewModel("Compromissos do período")' />
    @if (!Model.Any()) { <p class="muted">Nenhum compromisso cadastrado neste período.</p> }
    else
    {
        <div class="table-responsive"><table class="table align-middle agenda-events-table"><thead><tr><th>Data</th><th>Compromisso e edição</th><th>Perícia / periciado</th><th>Local / modalidade</th><th>Ações</th></tr></thead><tbody>
        @foreach (var e in Model)
        {
            <tr id="compromisso-@e.Id"><td>@e.Inicio.ToString("ddd, dd/MM HH:mm")</td><td><form asp-action="AtualizarEvento" method="post" class="d-grid gap-1"><input type="hidden" name="id" value="@e.Id" /><input type="hidden" name="periciadoId" value="@e.PericiadoId" /><input name="titulo" value="@e.Titulo" class="form-control form-control-sm" maxlength="160" required /><input type="datetime-local" name="inicio" value="@e.Inicio.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" required /><input type="datetime-local" name="fim" value="@e.Fim?.ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" /><input name="local" value="@e.Local" class="form-control form-control-sm" maxlength="240" placeholder="Local" /><select name="modalidade" class="form-select form-select-sm"><option value="">Não definida</option><option value="Presencial" selected="@(e.Modalidade == "Presencial")">Presencial</option><option value="Online" selected="@(e.Modalidade == "Online")">Online</option><option value="Telefone" selected="@(e.Modalidade == "Telefone")">Telefone</option></select><textarea name="observacoes" class="form-control form-control-sm" maxlength="2000" placeholder="Observações">@e.Observacoes</textarea><button class="btn btn-sm btn-outline-secondary">Salvar alteração / reagendar</button></form></td><td>@e.Pericia.Numero<div class="case-number">@e.Periciado?.Nome</div></td><td>@e.Local<div class="case-number">@e.Modalidade</div></td><td><form asp-action="CancelarEvento" method="post"><input type="hidden" name="id" value="@e.Id" /><button class="btn btn-sm btn-outline-danger" data-confirm-message="Cancelar este compromisso?">Cancelar</button></form></td></tr>
        }
        </tbody></table></div>
    }
</section>
@section Scripts {
<script>
(() => {
 const form = document.querySelector('form[action*="CriarEvento"]');
 const process = form?.querySelector('select[name="periciaId"]');
 const person = form?.querySelector('select[name="periciadoId"]');
 if (!process || !person) return;
 const filter = () => {
  for (const option of person.options) {
   if (!option.value) continue;
   option.hidden = option.dataset.pericia !== process.value;
   if (option.hidden && option.selected) person.value = "";
  }
 };
 process.addEventListener('change', filter);
 filter();
})();
</script>
}
