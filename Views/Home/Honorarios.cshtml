@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@{ ViewData["Title"] = "Honorários"; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("CONTROLE FINANCEIRO", "Honorários", "Valores fixados, recebidos e saldos pendentes.")' /></header>
<div class="stats-grid"><div class="stat-card"><div class="stat-label">FIXADOS</div><div class="stat-value money">@(((decimal)ViewBag.Fixado).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">SOLICITADOS</div><div class="stat-value money">@(((decimal)ViewBag.Solicitado).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">LIBERADOS</div><div class="stat-value money">@(((decimal)ViewBag.Liberado).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">RECEBIDOS</div><div class="stat-value money">@(((decimal)ViewBag.Recebido).ToString("C"))</div></div><div class="stat-card"><div class="stat-label">A RECEBER</div><div class="stat-value money">@(((decimal)ViewBag.Pendente).ToString("C"))</div></div></div>
<section class="list-panel"><form method="get" class="filters"><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar processo, perícia ou periciado"/></div><select name="situacao" class="form-select"><option value="">Todos</option><option value="pendente" selected="@(ViewBag.Situacao == "pendente")">Com saldo</option><option value="quitado" selected="@(ViewBag.Situacao == "quitado")">Quitado</option></select><button class="btn btn-outline-secondary">Filtrar</button></form><div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERICIADOS</th><th>HONORÁRIOS</th><th>RECEBIDO</th><th>SALDO</th><th>ÚLTIMOS PAGAMENTOS</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td>@(p.NumeroProcesso ?? "CNJ não informado")<div class="case-number">Perícia @p.Numero · @string.Join(", ", p.Periciados.Select(x => x.Nome))</div></td><td>@p.ValorHonorarios.ToString("C")</td><td>@p.ValorRecebido.ToString("C")</td><td><strong>@Math.Max(0, p.ValorHonorarios - p.ValorRecebido).ToString("C")</strong></td><td>@foreach (var pag in p.Pagamentos.OrderByDescending(x => x.DataRecebimento).Take(2)) { <div>@pag.DataRecebimento?.ToString("dd/MM/yyyy") · @pag.Valor.ToString("C")</div> }</td><td><a asp-action="Processo" asp-route-id="@p.Id" asp-fragment="honorarios" class="action-link">Detalhes</a></td></tr> }</tbody></table></div></section>
