@model Sistemas_para_pericias.Models.Pericia
@using Sistemas_para_pericias.Models
@{
    ViewData["Title"] = "Laudos da perícia";
    var modelos = (IEnumerable<ModeloLaudo>)ViewBag.Modelos;
    string StatusLaudoNome(StatusLaudo status) => status switch { StatusLaudo.EmElaboracao => "Em elaboração", StatusLaudo.Concluido => "Concluído", _ => status.ToString() };
}
<header class="page-heading"><div><a asp-action="Laudos" class="back-link">← Voltar à Central de laudos</a><partial name="_PageTitle" model='new PageHeadingViewModel("GESTÃO DE LAUDOS", "Laudos da perícia", $"Perícia nº {Model.Numero}")' /></div></header>
@if (TempData["Mensagem"] is string mensagem) { <div class="alert alert-success">@mensagem</div> }
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<section class="form-panel pericia-laudos-create mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Criar laudo", "O número será gerado automaticamente.")' /><form asp-action="CriarLaudo" method="post" class="pericia-laudos-create-form"><input type="hidden" name="periciaId" value="@Model.Id"/><label>Periciado relacionado<select name="periciadoId" class="form-select"><option value="">Sem associação</option>@foreach (var pessoa in Model.Periciados.OrderBy(p => p.Nome)) { <option value="@pessoa.Id">@pessoa.Nome</option> }</select></label><label>Modelo opcional<select name="modeloId" class="form-select"><option value="">Começar em branco</option>@foreach (var modelo in modelos) { <option value="@modelo.Id">@modelo.Nome</option> }</select></label><button type="submit" class="btn btn-primary">Criar e abrir editor</button></form></section>
<section class="list-panel"><div class="list-heading"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Laudos desta perícia", $"{Model.Laudos.Count} laudos")' /></div>
@if (Model.Laudos.Count == 0) { <div class="empty-state"><h3>Nenhum laudo cadastrado</h3><p>Use o formulário acima para criar o primeiro laudo desta perícia.</p></div> }
else { <div class="table-responsive"><table class="table cases-table pericia-laudos-table"><thead><tr><th>NÚMERO</th><th>PERICIADO</th><th>STATUS</th><th>PRAZO / ATUALIZADO</th><th>AÇÕES</th></tr></thead><tbody>@foreach (var laudo in Model.Laudos.OrderBy(l => int.TryParse(l.NumeroLaudo, out var numero) ? numero : int.MaxValue)) { <tr><td><div class="person-name">Laudo @laudo.NumeroLaudo</div><div class="case-number">@(laudo.Tipo ?? "Sem tipo")</div></td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td><form asp-action="AtualizarStatusLaudo" method="post" class="laudo-status-form"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="laudoId" value="@laudo.Id"/><input type="hidden" name="origem" value="laudos-pericia"/><select name="status" class="form-select form-select-sm">@foreach (var status in Enum.GetValues<StatusLaudo>()) { <option value="@status" selected="@(status == laudo.Status)">@StatusLaudoNome(status)</option> }</select><button class="btn btn-sm btn-outline-secondary">Salvar</button></form></td><td>@(laudo.Prazo?.ToString("dd/MM/yyyy") ?? "Sem prazo")<div class="case-number">@laudo.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td><td><a asp-action="EditorLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id" class="action-link">Abrir editor</a><form asp-action="ExcluirLaudo" asp-route-id="@Model.Id" asp-route-laudoId="@laudo.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" data-confirm-message="Excluir este laudo?">Excluir</button></form></td></tr> }</tbody></table></div>}
</section>
