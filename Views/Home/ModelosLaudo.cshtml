@model Sistemas_para_pericias.Models.ModeloLaudo
@{ ViewData["Title"] = "Modelos de laudo"; var modelos = (IEnumerable<Sistemas_para_pericias.Models.ModeloLaudo>)ViewBag.Modelos; }
<header class="page-heading"><div><a asp-action="Laudos" class="back-link">← Voltar para laudos</a><partial name="_PageTitle" model='new PageHeadingViewModel("PADRÕES DE DOCUMENTO", "Modelos de laudo", "Salve estruturas reutilizáveis. O laudo criado recebe uma cópia inicial e pode ser editado livremente.")' /></div></header>
@if (TempData["MensagemModelo"] is string msg) { <div class="alert alert-success">@msg</div> } @if (TempData["ErroModelo"] is string erro) { <div class="alert alert-danger">@erro</div> }
<section class="form-panel mb-3"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Novo modelo")' /><form asp-action="SalvarModeloLaudo" method="post"><input type="hidden" name="id" value="0"/><div class="mb-3"><label class="form-label">Nome do modelo</label><input name="nome" class="form-control" maxlength="100" required/></div><div class="mb-3"><label class="form-label">Conteúdo inicial</label><textarea name="conteudoHtml" class="form-control" rows="8" maxlength="100000" placeholder="Você pode usar HTML básico: &lt;h2&gt;Identificação&lt;/h2&gt;&lt;p&gt;Texto...&lt;/p&gt;"></textarea><div class="form-text">Scripts e estilos são removidos. O editor aceita parágrafos, títulos, listas e tabelas.</div></div><button class="btn btn-primary">Salvar modelo</button></form></section>
@foreach (var modelo in modelos) { <section class="form-panel mb-3"><form asp-action="SalvarModeloLaudo" method="post"><input type="hidden" name="id" value="@modelo.Id"/><div class="mb-3"><label class="form-label">Nome do modelo</label><input name="nome" value="@modelo.Nome" class="form-control" maxlength="100" required/></div><div class="mb-3"><label class="form-label">Conteúdo inicial (HTML básico)</label><textarea name="conteudoHtml" class="form-control" rows="8" maxlength="100000">@modelo.ConteudoHtml</textarea></div><button class="btn btn-outline-secondary">Salvar alterações</button></form><form asp-action="ExcluirModeloLaudo" method="post" class="mt-2"><input type="hidden" name="id" value="@modelo.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir este modelo? Laudos já criados não serão alterados.')">Excluir modelo</button></form></section> }
