@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@using Sistemas_para_pericias.Models
@{
    ViewData["Title"] = "Processos";
    var arquivadas = ViewBag.Arquivadas == true;
    string StatusNome(StatusPericia s) => s switch { StatusPericia.AguardandoAceite => "Aguardando aceite", StatusPericia.EmAndamento => "Em andamento", StatusPericia.LaudoEnviado => "Laudo enviado", StatusPericia.AguardandoPagamento => "Aguardando pagamento", StatusPericia.Concluida => "Concluída", StatusPericia.Recusada => "Recusada", _ => "Cancelada" };
}
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("ACERVO PERICIAL", arquivadas ? "Processos arquivados" : "Processos e perícias", arquivadas ? "Consulte perícias concluídas e quitadas, canceladas ou recusadas." : "Pesquise e acompanhe os processos em andamento.")' /><div class="heading-actions"><a asp-action="Criar" class="btn btn-primary">+ Novo processo</a></div></header>
<nav class="nav nav-tabs process-tabs mb-3" aria-label="Visualização de processos"><a class="nav-link @(!arquivadas ? "active" : "")" asp-action="Processos" asp-route-arquivadas="false">Em acompanhamento</a><a class="nav-link @(arquivadas ? "active" : "")" asp-action="Processos" asp-route-arquivadas="true">Arquivadas</a></nav>
<section class="list-panel">
@if (arquivadas)
{
    <form method="get" class="filters mb-3"><input type="hidden" name="arquivadas" value="true"/><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome, processo ou perícia"/></div><button class="btn btn-outline-secondary">Buscar</button><a asp-action="Processos" asp-route-arquivadas="true" class="clear-filter">Limpar</a></form>
    @if (!Model.Any()) { <div class="empty-state"><h3>Nenhum processo arquivado</h3><p>Casos concluídos e quitados ou encerrados aparecerão aqui.</p></div> }
    else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERICIADOS</th><th>PERÍCIA</th><th>DATA DE ENVIO</th><th>HONORÁRIOS</th><th>RECEBIDO</th><th>SITUAÇÃO</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><strong>@(p.NumeroProcesso ?? "CNJ não informado")</strong><div class="case-number">@string.Join(", ", p.Periciados.Select(x => x.Nome).DefaultIfEmpty(p.NomePericiado))</div></td><td>@p.Numero</td><td>@(p.DataEnvio?.ToString("dd/MM/yyyy") ?? "—")</td><td>@p.ValorHonorarios.ToString("C")</td><td>@p.ValorRecebido.ToString("C")</td><td>@StatusNome(p.Status)</td><td><a asp-action="Processo" asp-route-id="@p.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div> }
}
else
{
    <form method="get" class="process-filters"><input type="hidden" name="arquivadas" value="false"/>
        <div class="process-filter search-filter"><label for="busca">Buscar processos</label><input id="busca" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="CNJ, perícia, laudo ou periciado"/></div>
        <div class="process-filter"><label for="comarca">Comarca</label><select id="comarca" name="comarca" class="form-select"><option value="">Todas</option>@foreach (string item in ViewBag.Comarcas) { <option selected="@(ViewBag.ComarcaFiltro == item)">@item</option> }</select></div>
        <div class="process-filter"><label for="status">Status técnico</label><select id="status" name="status" class="form-select"><option value="">Todos</option>@foreach (var s in Enum.GetValues<StatusPericia>()) { <option value="@s" selected="@(ViewBag.StatusFiltro == s)">@StatusNome(s)</option> }</select></div>
        <div class="process-filter"><label for="financeiro">Financeiro</label><select id="financeiro" name="financeiro" class="form-select"><option value="">Todos</option><option value="pendente" selected="@(ViewBag.Financeiro == "pendente")">Com saldo</option><option value="quitado" selected="@(ViewBag.Financeiro == "quitado")">Quitado</option></select></div>
        <div class="process-filter"><label for="laudosMin">Laudos: mínimo</label><input id="laudosMin" name="laudosMin" value="@ViewBag.LaudosMin" type="number" min="0" class="form-control"/></div>
        <div class="process-filter"><label for="laudosMax">Laudos: máximo</label><input id="laudosMax" name="laudosMax" value="@ViewBag.LaudosMax" type="number" min="0" class="form-control"/></div>
        <div class="process-filter"><label for="honorariosMin">Honorários: mínimo</label><input id="honorariosMin" name="honorariosMin" value="@ViewBag.HonorariosMin" type="number" min="0" step="0.01" class="form-control"/></div>
        <div class="process-filter"><label for="honorariosMax">Honorários: máximo</label><input id="honorariosMax" name="honorariosMax" value="@ViewBag.HonorariosMax" type="number" min="0" step="0.01" class="form-control"/></div>
        <div class="process-filter"><label for="enviadoDe">Enviado de</label><input id="enviadoDe" name="enviadoDe" value="@ViewBag.EnviadoDe" type="date" class="form-control"/></div>
        <div class="process-filter"><label for="enviadoAte">Enviado até</label><input id="enviadoAte" name="enviadoAte" value="@ViewBag.EnviadoAte" type="date" class="form-control"/></div>
        <div class="process-filter-actions"><button class="btn btn-primary">Aplicar filtros</button><a asp-action="Processos" asp-route-arquivadas="false" class="btn btn-light">Limpar</a></div>
    </form>
    @if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">⌕</div><h3>Nenhum processo encontrado</h3><p>Cadastre um processo ou ajuste os filtros aplicados.</p><a asp-action="Criar" class="btn btn-primary">Cadastrar processo</a></div> }
    else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERÍCIA</th><th>PERICIADOS</th><th>LAUDOS</th><th>HONORÁRIOS / SALDO</th><th>ENTREGA / STATUS</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><strong>@(p.NumeroProcesso ?? "CNJ não informado")</strong><div class="case-number">Perícia nº @p.Numero · @p.Comarca / @p.Vara</div></td><td>@string.Join(", ", p.Periciados.Select(x => x.Nome).DefaultIfEmpty(p.NomePericiado))</td><td>@p.Laudos.Count</td><td>@p.ValorHonorarios.ToString("C")<div class="case-number">Saldo @Math.Max(0, p.ValorHonorarios - p.ValorRecebido).ToString("C")</div></td><td>@StatusNome(p.Status)<div class="case-number">Prazo: @(p.PrazoLaudo?.ToString("dd/MM/yyyy") ?? "—")</div></td><td><a asp-action="Processo" asp-route-id="@p.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div> }
}
<nav class="process-pagination" aria-label="Paginação"><span>Página @ViewBag.Pagina de @ViewBag.TotalPaginas</span><ul class="pagination">@for (var i = 1; i <= (int)ViewBag.TotalPaginas; i++) { <li class="page-item @(i == (int)ViewBag.Pagina ? "active" : "")"><a class="page-link" asp-action="Processos" asp-route-arquivadas="@arquivadas" asp-route-busca="@ViewBag.Busca" asp-route-comarca="@ViewBag.ComarcaFiltro" asp-route-status="@ViewBag.StatusFiltro" asp-route-financeiro="@ViewBag.Financeiro" asp-route-honorariosMin="@ViewBag.HonorariosMin" asp-route-honorariosMax="@ViewBag.HonorariosMax" asp-route-laudosMin="@ViewBag.LaudosMin" asp-route-laudosMax="@ViewBag.LaudosMax" asp-route-enviadoDe="@ViewBag.EnviadoDe" asp-route-enviadoAte="@ViewBag.EnviadoAte" asp-route-pagina="@i">@i</a></li> }</ul></nav>
</section>
