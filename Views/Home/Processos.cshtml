@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@using Sistemas_para_pericias.Models
@{
    ViewData["Title"] = "Processos";
    var arquivadas = ViewBag.Arquivadas == true;
    string StatusNome(StatusPericia s) => s switch { StatusPericia.AguardandoAceite => "Aguardando aceite", StatusPericia.EmAndamento => "Em andamento", StatusPericia.LaudoEnviado => "Laudo enviado", StatusPericia.AguardandoPagamento => "Aguardando pagamento", StatusPericia.Concluida => "Concluída", StatusPericia.Recusada => "Recusada", _ => "Cancelada" };
}
<div class="page-heading"><div><div class="eyebrow">ACERVO PERICIAL</div><h1>@(arquivadas ? "Processos arquivados" : "Processos e perícias")</h1><p>@(arquivadas ? "Consulte perícias concluídas e quitadas, canceladas ou recusadas." : "Pesquise e acompanhe os processos em andamento.")</p></div><div class="heading-actions"><a asp-action="Criar" class="btn btn-primary">+ Novo processo</a></div></div>
<nav class="nav nav-tabs mb-3" aria-label="Visualização de processos"><a class="nav-link @(!arquivadas ? "active" : "")" asp-action="Processos" asp-route-arquivadas="false">Em acompanhamento</a><a class="nav-link @(arquivadas ? "active" : "")" asp-action="Processos" asp-route-arquivadas="true">Arquivadas</a></nav>
<section class="list-panel">
@if (arquivadas)
{
    <form method="get" class="filters mb-3"><input type="hidden" name="arquivadas" value="true"/><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome, processo ou perícia"/></div><button class="btn btn-outline-secondary">Buscar</button><a asp-action="Processos" asp-route-arquivadas="true" class="clear-filter">Limpar</a></form>
    @if (!Model.Any()) { <div class="empty-state"><h3>Nenhum processo arquivado</h3><p>Casos concluídos e quitados ou encerrados aparecerão aqui.</p></div> }
    else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERICIADOS</th><th>PERÍCIA</th><th>DATA DE ENVIO</th><th>HONORÁRIOS</th><th>RECEBIDO</th><th>SITUAÇÃO</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><strong>@(p.NumeroProcesso ?? "CNJ não informado")</strong><div class="case-number">@string.Join(", ", p.Periciados.Select(x => x.Nome).DefaultIfEmpty(p.NomePericiado))</div></td><td>@p.Numero</td><td>@(p.DataEnvio?.ToString("dd/MM/yyyy") ?? "—")</td><td>@p.ValorHonorarios.ToString("C")</td><td>@p.ValorRecebido.ToString("C")</td><td>@StatusNome(p.Status)</td><td><a asp-action="Processo" asp-route-id="@p.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div> }
}
else
{
    <form method="get" class="row g-2 mb-3"><input type="hidden" name="arquivadas" value="false"/><div class="col-lg-4"><label class="form-label">Busca exata ou parcial</label><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="CNJ, perícia, laudo ou periciado"/></div><div class="col-lg-2"><label class="form-label">Comarca</label><select name="comarca" class="form-select"><option value="">Todas</option>@foreach (string item in ViewBag.Comarcas) { <option selected="@(ViewBag.ComarcaFiltro == item)">@item</option> }</select></div><div class="col-lg-2"><label class="form-label">Status técnico</label><select name="status" class="form-select"><option value="">Todos</option>@foreach (var s in Enum.GetValues<StatusPericia>()) { <option value="@s" selected="@(ViewBag.StatusFiltro == s)">@StatusNome(s)</option> }</select></div><div class="col-lg-2"><label class="form-label">Financeiro</label><select name="financeiro" class="form-select"><option value="">Todos</option><option value="pendente" selected="@(ViewBag.Financeiro == "pendente")">Com saldo</option><option value="quitado" selected="@(ViewBag.Financeiro == "quitado")">Quitado</option></select></div><div class="col-lg-2"><label class="form-label">Laudos mín. / máx.</label><div class="d-flex gap-1"><input name="laudosMin" value="@ViewBag.LaudosMin" type="number" min="0" class="form-control"/><input name="laudosMax" value="@ViewBag.LaudosMax" type="number" min="0" class="form-control"/></div></div><div class="col-lg-2"><label class="form-label">Honorários mín.</label><input name="honorariosMin" value="@ViewBag.HonorariosMin" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-lg-2"><label class="form-label">Honorários máx.</label><input name="honorariosMax" value="@ViewBag.HonorariosMax" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-lg-2"><label class="form-label">Enviado de</label><input name="enviadoDe" value="@ViewBag.EnviadoDe" type="date" class="form-control"/></div><div class="col-lg-2"><label class="form-label">Enviado até</label><input name="enviadoAte" value="@ViewBag.EnviadoAte" type="date" class="form-control"/></div><div class="col-lg-4 d-flex align-items-end gap-2"><button class="btn btn-primary">Aplicar filtros</button><a asp-action="Processos" asp-route-arquivadas="false" class="btn btn-light">Limpar</a></div></form>
    <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERÍCIA</th><th>PERICIADOS</th><th>LAUDOS</th><th>HONORÁRIOS / SALDO</th><th>ENTREGA / STATUS</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><strong>@(p.NumeroProcesso ?? "CNJ não informado")</strong><div class="case-number">Perícia nº @p.Numero · @p.Comarca / @p.Vara</div></td><td>@string.Join(", ", p.Periciados.Select(x => x.Nome).DefaultIfEmpty(p.NomePericiado))</td><td>@p.Laudos.Count</td><td>@p.ValorHonorarios.ToString("C")<div class="case-number">Saldo @Math.Max(0, p.ValorHonorarios - p.ValorRecebido).ToString("C")</div></td><td>@StatusNome(p.Status)<div class="case-number">Prazo: @(p.PrazoLaudo?.ToString("dd/MM/yyyy") ?? "—")</div></td><td><a asp-action="Processo" asp-route-id="@p.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div>
}
</section>
<nav aria-label="Paginação"><ul class="pagination">@for (var i = 1; i <= (int)ViewBag.TotalPaginas; i++) { <li class="page-item @(i == (int)ViewBag.Pagina ? "active" : "")"><a class="page-link" asp-action="Processos" asp-route-arquivadas="@arquivadas" asp-route-busca="@ViewBag.Busca" asp-route-comarca="@ViewBag.ComarcaFiltro" asp-route-status="@ViewBag.StatusFiltro" asp-route-financeiro="@ViewBag.Financeiro" asp-route-honorariosMin="@ViewBag.HonorariosMin" asp-route-honorariosMax="@ViewBag.HonorariosMax" asp-route-laudosMin="@ViewBag.LaudosMin" asp-route-laudosMax="@ViewBag.LaudosMax" asp-route-enviadoDe="@ViewBag.EnviadoDe" asp-route-enviadoAte="@ViewBag.EnviadoAte" asp-route-pagina="@i">@i</a></li> }</ul></nav>
