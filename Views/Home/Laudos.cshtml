@model IEnumerable<Sistemas_para_pericias.Models.LaudoPericia>
@{
    ViewData["Title"] = "Laudos";
}
<div class="page-heading"><div><div class="eyebrow">DOCUMENTOS TÉCNICOS</div><h1>Laudos</h1><p>Consulte os laudos de cada perícia ou inicie outro.</p></div><div class="heading-actions"><a class="btn btn-primary btn-lg" asp-action="NovoLaudo">＋ Novo laudo</a></div></div>
<section class="list-panel"><div class="list-heading"><div><h2>Laudos cadastrados</h2><span class="muted">@Model.Count() registros</span></div></div>
<form method="get" class="filters"><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por pessoa, perícia ou laudo..." /></div><button class="btn btn-outline-secondary">Buscar</button>@if (ViewBag.Busca != null) { <a asp-action="Laudos" class="clear-filter">Limpar</a> }</form>
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">▧</div><h3>Nenhum laudo cadastrado</h3><p>Crie um laudo vinculado a uma perícia para começar.</p><a asp-action="NovoLaudo" class="btn btn-primary">Criar primeiro laudo</a></div> }
else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>Nº DO LAUDO</th><th>PERICIADO</th><th>PERÍCIA</th><th>ATUALIZADO</th><th></th></tr></thead><tbody>@foreach (var laudo in Model) { <tr><td><div class="person-name">Laudo @laudo.NumeroLaudo</div><div class="case-number">@(string.IsNullOrWhiteSpace(laudo.ConteudoHtml) ? "Rascunho vazio" : "Rascunho salvo")</div></td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td><div class="person-name">@laudo.Pericia.NomePericiado</div><div class="case-number">Nº @laudo.Pericia.Numero</div></td><td>@laudo.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td class="actions"><a asp-action="EditorLaudo" asp-route-id="@laudo.PericiaId" asp-route-laudoId="@laudo.Id" class="action-link">Abrir</a></td></tr> }</tbody></table></div>}
</section>
