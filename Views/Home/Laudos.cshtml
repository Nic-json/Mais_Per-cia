@model IEnumerable<Sistemas_para_pericias.Models.LaudoPericia>
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Laudos"; string StatusLaudoNome(StatusLaudo s) => s switch { StatusLaudo.EmElaboracao => "Em elaboração", StatusLaudo.Concluido => "Concluído", _ => s.ToString() }; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("DOCUMENTOS TÉCNICOS", "Laudos", "Consulte laudos de todos os processos, prazos e estados de elaboração.")' /><div class="heading-actions"><a class="btn btn-outline-secondary" asp-action="ModelosLaudo">Modelos</a><a class="btn btn-primary btn-lg" asp-action="NovoLaudo">+ Novo laudo</a></div></header>
<section class="list-panel"><div class="list-heading"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Central de laudos", $"{Model.Count()} registros")' /></div>
<form method="get" class="filters"><div class="search-wrap"><input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Processo, periciado ou número do laudo" /></div><select name="status" class="form-select"><option value="">Todos os estados</option>@foreach (var s in Enum.GetValues<StatusLaudo>()) { <option value="@s" selected="@(ViewBag.StatusFiltro == s)">@StatusLaudoNome(s)</option> }</select><label class="form-label mb-0">Prazo até <input type="date" name="prazoAte" value="@ViewBag.PrazoAte" class="form-control" /></label><button class="btn btn-outline-secondary">Filtrar</button><a asp-action="Laudos" class="clear-filter">Limpar</a></form>
@if (!Model.Any()) { <div class="empty-state"><h3>Nenhum laudo encontrado</h3><p>Crie um laudo vinculado a uma perícia.</p><a asp-action="NovoLaudo" class="btn btn-primary">Criar primeiro laudo</a></div> }
else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>LAUDO / TIPO</th><th>PERICIADO</th><th>PROCESSO / PERÍCIA</th><th>ESTADO</th><th>PRAZO / ATUALIZADO</th><th></th></tr></thead><tbody>@foreach (var laudo in Model) { <tr><td><div class="person-name">Laudo @laudo.NumeroLaudo</div><div class="case-number">@(laudo.Tipo ?? "Sem tipo")</div></td><td>@(laudo.Periciado?.Nome ?? "Não associado")</td><td><div class="person-name">@(laudo.Pericia.NumeroProcesso ?? "CNJ não informado")</div><div class="case-number">Perícia nº @laudo.Pericia.Numero</div></td><td><form asp-action="AtualizarStatusLaudo" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@laudo.PericiaId"/><input type="hidden" name="laudoId" value="@laudo.Id"/><input type="hidden" name="origem" value="laudos"/><select name="status" class="form-select form-select-sm">@foreach (var s in Enum.GetValues<StatusLaudo>()) { <option value="@s" selected="@(s == laudo.Status)">@StatusLaudoNome(s)</option> }</select><button class="btn btn-sm btn-outline-secondary">Salvar</button></form></td><td>@(laudo.Prazo?.ToString("dd/MM/yyyy") ?? "Sem prazo")<div class="case-number">@laudo.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td><td><a asp-action="EditorLaudo" asp-route-id="@laudo.PericiaId" asp-route-laudoId="@laudo.Id" class="action-link">Abrir editor</a></td></tr> }</tbody></table></div>}
</section>
