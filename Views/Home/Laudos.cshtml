@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@using Sistemas_para_pericias.Models
@{ ViewData["Title"] = "Laudos"; string StatusLaudoNome(StatusLaudo s) => s switch { StatusLaudo.EmElaboracao => "Em elaboração", StatusLaudo.Concluido => "Concluído", _ => s.ToString() }; }
<header class="page-heading"><partial name="_PageTitle" model='new PageHeadingViewModel("DOCUMENTOS TÉCNICOS", "Laudos", "Abra uma perícia para consultar os laudos vinculados a ela.")' /><div class="heading-actions"><a class="btn btn-outline-secondary" asp-action="ModelosLaudo">Modelos</a></div></header>
<section class="list-panel"><div class="list-heading"><partial name="_PanelTitle" model='new PanelHeadingViewModel("Perícias com laudos", $"{Model.Count()} perícias")' /></div>
<form method="get" class="laudos-filters">
    <label class="laudos-filter laudos-search">Buscar perícias
        <input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Número da perícia ou periciado" />
    </label>
    <label class="laudos-filter">Estado de algum laudo
        <select name="status" class="form-select"><option value="">Todos os estados</option>@foreach (var s in Enum.GetValues<StatusLaudo>()) { <option value="@s" selected="@(ViewBag.StatusFiltro == s)">@StatusLaudoNome(s)</option> }</select>
    </label>
    <label class="laudos-filter">Prazo até
        <input type="date" name="prazoAte" value="@ViewBag.PrazoAte" class="form-control" />
    </label>
    <div class="laudos-filter-actions">
        <button class="btn btn-outline-secondary">Pesquisar</button>
        <a asp-action="Laudos" class="btn btn-outline-secondary">Limpar</a>
    </div>
</form>
@if (!Model.Any()) { <div class="empty-state"><h3>Nenhuma perícia com laudos encontrada</h3><p>As perícias aparecerão aqui depois que tiverem ao menos um laudo.</p></div> }
else { <div class="table-responsive"><table class="table cases-table laudos-table laudos-process-table"><thead><tr><th>PERÍCIA</th><th>PERICIADOS</th><th>LAUDOS</th><th>ATUALIZADO</th><th></th></tr></thead><tbody>@foreach (var pericia in Model) { var concluidos = pericia.Laudos.Count(laudo => laudo.Status == StatusLaudo.Concluido); var emElaboracao = pericia.Laudos.Count(laudo => laudo.Status == StatusLaudo.EmElaboracao); <tr><td><div class="person-name">Perícia nº @pericia.Numero</div><div class="case-number">@pericia.Comarca / @pericia.Vara</div></td><td>@(pericia.Periciados.Count == 0 ? "Sem periciados cadastrados" : string.Join(", ", pericia.Periciados.OrderBy(pessoa => pessoa.Nome).Select(pessoa => pessoa.Nome)))</td><td><div class="person-name">@pericia.Laudos.Count laudo(s)</div><div class="case-number">@emElaboracao em elaboração · @concluidos concluído(s)</div></td><td>@(pericia.Laudos.Max(laudo => (DateTime?)laudo.AtualizadoEm)?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td><a asp-action="LaudosDaPericia" asp-route-id="@pericia.Id" class="action-link">Abrir laudos</a></td></tr> }</tbody></table></div>}
</section>