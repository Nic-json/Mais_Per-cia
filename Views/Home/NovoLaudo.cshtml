@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@{ ViewData["Title"] = "Novo laudo"; var modelos = (IEnumerable<Sistemas_para_pericias.Models.ModeloLaudo>)ViewBag.Modelos; }
<header class="page-heading"><div><a asp-action="Laudos" class="back-link">← Voltar para laudos</a><partial name="_PageTitle" model='new PageHeadingViewModel("NOVO DOCUMENTO", "Escolha o processo", "Escolha a pessoa relacionada e um modelo inicial opcional.")' /></div><div class="heading-actions"><a asp-action="ModelosLaudo" class="btn btn-outline-secondary">Gerenciar modelos</a></div></header>
<section class="list-panel">
@if (!Model.Any()) { <div class="empty-state"><h3>Não há perícias ativas</h3><p>Cadastre uma perícia antes de iniciar um laudo.</p><a asp-action="Criar" asp-route-abrirLaudoDepois="true" class="btn btn-primary">Cadastrar perícia</a></div> }
else { <div class="table-responsive"><table class="table cases-table novo-laudo-table"><thead><tr><th>NÚMERO DA PERÍCIA / PERICIADOS</th><th>CRIAR LAUDO</th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><div class="person-name">Perícia nº @p.Numero</div><div class="case-number">@(p.Periciados.Count == 0 ? "Sem periciado" : string.Join(", ", p.Periciados.Select(x => x.Nome)))</div></td><td><form asp-action="CriarLaudo" method="post" class="novo-laudo-form"><input type="hidden" name="periciaId" value="@p.Id"/><label class="novo-laudo-person">Periciado<select name="periciadoId" class="form-select"><option value="">Sem associação</option>@foreach (var pessoa in p.Periciados) { <option value="@pessoa.Id">@pessoa.Nome</option> }</select></label><label class="novo-laudo-model">Modelo opcional<select name="modeloId" class="form-select"><option value="">Começar em branco</option>@foreach (var modelo in modelos) { <option value="@modelo.Id">@modelo.Nome</option> }</select></label><button class="btn btn-primary">Criar e abrir editor</button></form></td></tr> }</tbody></table></div>}
</section>
