@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@{
    ViewData["Title"] = "Novo laudo";
}
<div class="page-heading"><div><a asp-action="Laudos" class="back-link">← Voltar para laudos</a><div class="eyebrow">NOVO DOCUMENTO</div><h1>Escolha a perícia</h1><p>Informe o número do laudo e, se quiser, associe-o a um dos periciados.</p></div></div>
<section class="list-panel">
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">▧</div><h3>Não há perícias ativas</h3><p>Cadastre uma perícia antes de iniciar um laudo.</p><a asp-action="Criar" asp-route-abrirLaudoDepois="true" class="btn btn-primary">Cadastrar perícia</a></div> }
else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PERÍCIA / PERICIADOS</th><th>NÚMERO DO LAUDO</th><th>PERICIADO RELACIONADO</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><div class="person-name">Nº @p.Numero</div><div class="case-number">@string.Join(", ", p.Periciados.Select(pessoa => pessoa.Nome))</div></td><td colspan="3"><form asp-action="CriarLaudo" method="post" class="row g-2 align-items-end"><input type="hidden" name="periciaId" value="@p.Id" /><div class="col-sm-4"><label class="form-label visually-hidden" for="numero-@p.Id">Número do laudo</label><input id="numero-@p.Id" name="numeroLaudo" class="form-control" maxlength="80" required placeholder="Ex.: 1 ou 0001-A" /></div><div class="col-sm-5"><label class="form-label visually-hidden" for="periciado-@p.Id">Periciado relacionado</label><select id="periciado-@p.Id" name="periciadoId" class="form-select"><option value="">Sem associação</option>@foreach (var pessoa in p.Periciados.OrderBy(pessoa => pessoa.Nome)) { <option value="@pessoa.Id">@pessoa.Nome</option> }</select></div><div class="col-sm-3"><button type="submit" class="btn btn-primary">Criar laudo</button></div></form></td></tr> }</tbody></table></div>}
</section>
