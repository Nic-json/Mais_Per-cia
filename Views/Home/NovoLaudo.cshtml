@model IEnumerable<Sistemas_para_pericias.Models.Pericia>
@{ ViewData["Title"] = "Novo laudo"; var modelos = (IEnumerable<Sistemas_para_pericias.Models.ModeloLaudo>)ViewBag.Modelos; }
<header class="page-heading"><div><a asp-action="Laudos" class="back-link">← Voltar para laudos</a><partial name="_PageTitle" model='new PageHeadingViewModel("NOVO DOCUMENTO", "Escolha o processo", "Informe o número, a pessoa relacionada e um modelo inicial opcional.")' /></div><div class="heading-actions"><a asp-action="ModelosLaudo" class="btn btn-outline-secondary">Gerenciar modelos</a></div></header>
<section class="list-panel">
@if (!Model.Any()) { <div class="empty-state"><h3>Não há perícias ativas</h3><p>Cadastre uma perícia antes de iniciar um laudo.</p><a asp-action="Criar" asp-route-abrirLaudoDepois="true" class="btn btn-primary">Cadastrar perícia</a></div> }
else { <div class="table-responsive"><table class="table cases-table"><thead><tr><th>PROCESSO / PERICIADOS</th><th>CRIAR LAUDO</th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><div class="person-name">@(p.NumeroProcesso ?? "CNJ não informado")</div><div class="case-number">Perícia nº @p.Numero · @string.Join(", ", p.Periciados.Select(x => x.Nome))</div></td><td><form asp-action="CriarLaudo" method="post" class="row g-2 align-items-end"><input type="hidden" name="periciaId" value="@p.Id"/><div class="col-md-2"><label class="form-label">Número</label><input name="numeroLaudo" class="form-control" maxlength="80" required placeholder="Ex.: 1"/></div><div class="col-md-3"><label class="form-label">Periciado</label><select name="periciadoId" class="form-select"><option value="">Sem associação</option>@foreach (var pessoa in p.Periciados) { <option value="@pessoa.Id">@pessoa.Nome</option> }</select></div><div class="col-md-4"><label class="form-label">Modelo opcional</label><select name="modeloId" class="form-select"><option value="">Começar em branco</option>@foreach (var modelo in modelos) { <option value="@modelo.Id">@modelo.Nome</option> }</select></div><div class="col-md-3"><button class="btn btn-primary">Criar e abrir editor</button></div></form></td></tr> }</tbody></table></div>}
</section>
