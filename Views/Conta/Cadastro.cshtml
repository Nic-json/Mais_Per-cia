@model Sistemas_para_pericias.Models.CadastroContaViewModel
@{ ViewData["Title"] = "Criar conta"; Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Criar conta · Perícia Clara</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/site-enhancements.css" asp-append-version="true"/></head>
<body class="login-page"><main class="login-card"><a class="brand login-brand" href="/"><span class="brand-mark">P</span><span>perícia<span class="brand-light">clara</span><small>GESTÃO PERICIAL</small></span></a><div class="eyebrow">COMECE A ORGANIZAR</div><h1>Crie sua conta</h1><p class="login-intro">Sua conta é individual. Seus processos, laudos e documentos ficam separados dos de outros peritos.</p><form asp-action="Cadastro" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" autocomplete="name" autofocus/><span asp-validation-for="Nome" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control" autocomplete="new-password"/><span asp-validation-for="Senha" class="text-danger"></span></div><div class="mb-4"><label asp-for="ConfirmarSenha" class="form-label"></label><input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmarSenha" class="text-danger"></span></div><p class="small text-muted">Leia o <a asp-controller="Home" asp-action="Privacy">aviso preliminar de privacidade</a> antes de criar a conta.</p><button type="submit" class="btn btn-primary w-100 btn-lg">Criar conta</button></form><div class="login-note">Já tem conta? <a asp-action="Entrar">Entrar</a></div></main></body></html>
