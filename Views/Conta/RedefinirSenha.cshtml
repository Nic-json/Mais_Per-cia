@model Sistemas_para_pericias.Models.Responses.RedefinirSenhaViewModel
@{ ViewData["Title"] = "Criar nova senha"; Layout = null; }
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Criar nova senha · Perícia em Dia</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/site-enhancements.css" asp-append-version="true"/></head>
<body class="login-page"><main class="login-card"><div class="eyebrow">SUA CONTA</div><h1>Crie uma nova senha</h1><form asp-action="RedefinirSenha" method="post"><input asp-for="Token" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="NovaSenha" class="form-label"></label><input asp-for="NovaSenha" class="form-control" autocomplete="new-password"/><span asp-validation-for="NovaSenha" class="text-danger"></span></div><div class="mb-4"><label asp-for="ConfirmarNovaSenha" class="form-label"></label><input asp-for="ConfirmarNovaSenha" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmarNovaSenha" class="text-danger"></span></div><button class="btn btn-primary btn-lg w-100">Salvar nova senha</button></form></main></body></html>

