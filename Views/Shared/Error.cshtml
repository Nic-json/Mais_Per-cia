@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<header class="page-heading">
    <partial name="_PageTitle" model='new PageHeadingViewModel("SISTEMA", "Ocorreu um erro", "Não foi possível concluir esta solicitação.")' />
</header>
<section class="form-panel app-error-panel">
    <p>Tente novamente. Se o problema continuar, entre em contato com o suporte.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mb-0"><strong>Código de atendimento:</strong> <code>@Model.RequestId</code></p>
    }
</section>
