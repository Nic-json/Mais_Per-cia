<!DOCTYPE html>
<html lang="pt-BR">
<head><link rel="icon" type="image/png" href="~/images/pericia-em-dia-mark.png" asp-append-version="true"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Perícia em Dia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sistemas_para_pericias.styles.css" asp-append-version="true" />
</head>
<body>
 <div class="app-shell">
  @{ var actionAtual = ViewContext.RouteData.Values["action"]?.ToString(); }
  <aside class="sidebar">
   <a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-mark" src="~/images/pericia-em-dia-mark.png" alt=""/><span>Perícia <span class="brand-light">em Dia</span><small>GESTÃO PERICIAL</small></span></a>
   <nav class="side-navigation" aria-label="Navegação principal">
    <div class="side-caption">MENU PRINCIPAL</div>
    <a asp-controller="Home" asp-action="Index" class="side-link @(actionAtual == "Index" || actionAtual == "Criar" || actionAtual == "Editar" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.2"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.2"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.2"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.2"/></svg></span> Visão geral</a>
    <a asp-controller="Home" asp-action="Processos" asp-route-arquivadas="false" class="side-link @(actionAtual == "Processos" || actionAtual == "Processo" || actionAtual == "Arquivadas" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5h7l2 2h9v9.8a1.7 1.7 0 0 1-1.7 1.7H4.7A1.7 1.7 0 0 1 3 19.3z"/><path d="M3 7.5V5.7A1.7 1.7 0 0 1 4.7 4h4.6l2 2H17"/></svg></span> Processos</a>
    <a asp-controller="Home" asp-action="Laudos" class="side-link @(actionAtual == "Laudos" || actionAtual == "LaudosDaPericia" || actionAtual == "EditorLaudo" || actionAtual == "ModelosLaudo" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h8l4.5 4.7v12.3H6z"/><path d="M14 3.5v5h4.5M9 12h6M9 15.5h6"/></svg></span> Laudos</a>
    <a asp-controller="Home" asp-action="Agenda" class="side-link @(actionAtual == "Agenda" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M3.5 10h17M8 14h2M14 14h2M8 17.5h2"/></svg></span> Agenda</a>
    <a asp-controller="Home" asp-action="Honorarios" class="side-link @(actionAtual == "Honorarios" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M16 8.5c-.8-.8-2-1.2-3.5-1.2-1.9 0-3.2.9-3.2 2.3 0 3.4 7.4 1.4 7.4 5 0 1.5-1.5 2.5-3.7 2.5-1.6 0-3-.5-4-1.5M12 5.5v13"/></svg></span> Honorários</a>
    <a asp-controller="Home" asp-action="Relatorios" class="side-link @(actionAtual == "Relatorios" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V11M10 20V5M16 20v-7M22 20H2"/></svg></span> Relatórios</a>
    <a asp-controller="Home" asp-action="Configuracoes" class="side-link @(actionAtual == "Configuracoes" || actionAtual == "Banco" ? "active" : "")"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3h4l.6 2.2a7.6 7.6 0 0 1 1.6.9l2.2-.7 2 3.5-1.6 1.6a7 7 0 0 1 0 1.9l1.6 1.6-2 3.5-2.2-.7a7.6 7.6 0 0 1-1.6.9L14 20h-4l-.6-2.3a7.6 7.6 0 0 1-1.6-.9l-2.2.7-2-3.5 1.6-1.6a7 7 0 0 1 0-1.9L3.6 8.9l2-3.5 2.2.7a7.6 7.6 0 0 1 1.6-.9z"/><circle cx="12" cy="11.5" r="2.6"/></svg></span> Configurações</a>
    <form asp-controller="Conta" asp-action="Sair" method="post" class="mobile-logout"><button type="submit" class="side-link"><span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M21 4v16"/></svg></span> Sair</button></form>
   </nav>
   <div class="sidebar-footer"><span class="avatar">PD</span><span><b>@User.Identity?.Name</b><small>Perito</small></span><form asp-controller="Conta" asp-action="Sair" method="post" class="ms-auto"><button type="submit" class="logout-button" title="Sair">↗</button></form></div>
  </aside>
  <main class="main-area"><header class="topbar"><div class="breadcrumb">Painel <span>/</span> <b>@ViewData["Title"]</b></div><div class="topbar-right"><span class="today">@BrasiliaTime.Today.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))</span></div></header><div class="content-wrap">@RenderBody()</div><footer class="footer">Perícia em Dia <span>·</span> Gestão pericial.</footer></main>
 </div>
 <dialog class="app-confirm-dialog" id="app-confirm-dialog" aria-labelledby="app-confirm-title" aria-describedby="app-confirm-message">
  <form method="dialog" class="app-confirm-content">
   <div class="app-confirm-icon" aria-hidden="true">!</div>
   <div class="app-confirm-copy">
    <h2 id="app-confirm-title">Confirmar ação</h2>
    <p id="app-confirm-message"></p>
   </div>
   <div class="app-confirm-actions">
    <button type="submit" value="cancel" class="btn btn-outline-secondary">Cancelar</button>
    <button type="submit" value="confirm" class="btn btn-danger" id="app-confirm-accept">Confirmar</button>
   </div>
  </form>
 </dialog>
 <script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
