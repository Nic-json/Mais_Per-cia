<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Perícia Clara</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sistemas_para_pericias.styles.css" asp-append-version="true" />
</head>
<body>
 <div class="app-shell">
  @{ var actionAtual = ViewContext.RouteData.Values["action"]?.ToString(); }
  <aside class="sidebar">
   <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">P</span><span>perícia<span class="brand-light">clara</span><small>GESTÃO PERICIAL</small></span></a>
   <nav class="side-navigation" aria-label="Navegação principal">
    <div class="side-caption">MENU PRINCIPAL</div>
    <a asp-controller="Home" asp-action="Index" class="side-link @(actionAtual == "Index" || actionAtual == "Criar" || actionAtual == "Editar" ? "active" : "")"><span>⌂</span> Visão geral</a>
    <a asp-controller="Home" asp-action="Processos" asp-route-arquivadas="false" class="side-link @(actionAtual == "Processos" || actionAtual == "Processo" || actionAtual == "Arquivadas" ? "active" : "")"><span>▤</span> Processos</a>
    <a asp-controller="Home" asp-action="Laudos" class="side-link @(actionAtual == "Laudos" || actionAtual == "NovoLaudo" || actionAtual == "EditorLaudo" || actionAtual == "ModelosLaudo" ? "active" : "")"><span>▧</span> Laudos</a>
    <a asp-controller="Home" asp-action="Agenda" class="side-link @(actionAtual == "Agenda" ? "active" : "")"><span>◷</span> Agenda</a>
    <a asp-controller="Home" asp-action="Honorarios" class="side-link @(actionAtual == "Honorarios" ? "active" : "")"><span>R$</span> Honorários</a>
    <a asp-controller="Home" asp-action="Relatorios" class="side-link @(actionAtual == "Relatorios" ? "active" : "")"><span>▥</span> Relatórios</a>
    <a asp-controller="Home" asp-action="Configuracoes" class="side-link @(actionAtual == "Configuracoes" || actionAtual == "Banco" ? "active" : "")"><span>⚙</span> Configurações</a>
    <form asp-controller="Conta" asp-action="Sair" method="post" class="mobile-logout"><button type="submit" class="side-link"><span>↗</span> Sair</button></form>
   </nav>
   <div class="sidebar-footer"><span class="avatar">PC</span><span><b>@User.Identity?.Name</b><small>Perito</small></span><form asp-controller="Conta" asp-action="Sair" method="post" class="ms-auto"><button type="submit" class="logout-button" title="Sair">↗</button></form></div>
  </aside>
  <main class="main-area"><header class="topbar"><div class="breadcrumb">Painel <span>/</span> <b>@ViewData["Title"]</b></div><div class="topbar-right"><span class="today">@DateTime.Today.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))</span><span class="user-dot">P</span></div></header><div class="content-wrap">@RenderBody()</div><footer class="footer">Perícia Clara <span>·</span> Organize seu trabalho com tranquilidade.</footer></main>
 </div>
 <script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
